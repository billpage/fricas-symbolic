)abbrev domain SYMTERM SymbolicTerm
++ Author: Bill Page, Claude
++ Date Created: 26 November 2026
++ Description:
++ Design (II) of the fricas-symbolic specification (docs/spec/sexpr-spec.md,
++ sections 3.2 and 3.4; decisions 0008 and 0009): SymbolicTerm(R, A) is the
++ algebra of terms modulo the axiom groups A.  Every element is kept in the
++ normal form of A, and two elements are equal exactly when their normal
++ forms are identical, so equality is equality modulo A (no evaluation).
++ The normal forms are those of GeneralSymbolicExpression(R, A), which uses
++ the same groups as presentation axioms.  With A empty no rewriting takes
++ place.  No algebraic category is claimed: with the groups implemented so
++ far the ring laws do not hold modulo A.
SymbolicTerm(R, A) : Exports == Implementation where
  -- the same requirements as GeneralSymbolicExpression (gsexpr.spad)
  R : Join(ComparableRepresentation, GcdDomain, CharacteristicZero,
           RetractableTo Integer, ConvertibleTo InputForm)
  A : List Symbol
  G  ==> GeneralSymbolicExpression(R, A)
  E  ==> Expression R
  RN ==> Fraction Integer

  Exports ==> Join(SetCategory, ConvertibleTo InputForm) with
    0 : constant -> %
      ++ 0 is the numeral zero.
    1 : constant -> %
      ++ 1 is the numeral one.
    coerce : Symbol -> %
      ++ coerce(s) is the variable s.
    coerce : Integer -> %
      ++ coerce(n) is the numeral n.
    coerce : RN -> %
      ++ coerce(q) is the numeral q.
    coerce : R -> %
      ++ coerce(r) is the constant r.
    _+ : (%, %) -> %
      ++ x + y is the normal form of the sum.
    _- : (%, %) -> %
      ++ x - y is the normal form of the difference.
    _- : % -> %
      ++ -x is the normal form of the negation.
    _* : (%, %) -> %
      ++ x * y is the normal form of the product.
    _/ : (%, %) -> %
      ++ x / y is the normal form of the quotient.
    _^ : (%, Integer) -> %
      ++ x ^ n is the normal form of the power.
    sqrt : % -> %
      ++ sqrt(x) is the square root term.
    exp : % -> %
      ++ exp(x) is the exponential term.
    log : % -> %
      ++ log(x) is the logarithm term.
    sin : % -> %
      ++ sin(x) is the sine term.
    cos : % -> %
      ++ cos(x) is the cosine term.
    tan : % -> %
      ++ tan(x) is the tangent term.
    elt : (BasicOperator, List %) -> %
      ++ elt(op, [x1, ..., xn]) is the term op(x1, ..., xn).
    form : % -> InputForm
      ++ form(x) is the normal form of x.
    convert : InputForm -> %
      ++ convert(f) reads the term form f back: the normal form under A of
      ++ the term f, built by the operations of this domain (decision 0011).
      ++ convert(form x) = x.
    coerce : % -> E
      ++ coerce(x) evaluates x in Expression R; every axiom group is sound
      ++ for Expression R (spec 3.4).

  Implementation ==> add
    Rep := G
    -- conversions to and from the representation
    rp(x : %) : G == x pretend G
    pr(g : G) : % == g pretend %

    -- admissibility of A (spec 3.4, decision 0009), at instantiation
    IMPL ==> ['identities, 'annihilation, 'involutions, 'numerals, 'associativity, 'commutativity, 'linear, 'powers, 'quotients, 'ring, 'field]
    checkGroups("SymbolicTerm", A, IMPL)$SymbolicAxiomGroups

    -- equality modulo A: identity of normal forms
    x = y == (form(rp x)$G = form(rp y)$G)@Boolean
    form x == form(rp x)$G
    convert(x : %) : InputForm == form(rp x)$G
    coerce(x : %) : OutputForm == coerce(rp x)$G
    coerce(x : %) : E == value(rp x)$G

    0 == pr(0$G)
    1 == pr(1$G)
    coerce(s : Symbol) : % == pr(s::G)
    coerce(n : Integer) : % == pr(n::G)
    coerce(q : RN) : % == pr(q::G)
    coerce(r : R) : % == pr(r::G)

    x : % + y : % == pr(rp x + rp y)
    x : % - y : % == pr(rp x - rp y)
    - x : % == pr(- rp x)
    x : % * y : % == pr(rp x * rp y)
    x : % / y : % == pr(rp x / rp y)
    x : % ^ n : Integer == pr(rp x ^ n)
    sqrt x == pr sqrt(rp x)
    exp x == pr exp(rp x)
    log x == pr log(rp x)
    sin x == pr sin(rp x)
    cos x == pr cos(rp x)
    tan x == pr tan(rp x)
    elt(op : BasicOperator, l : List %) : % == pr elt(op, [rp a for a in l])$G
    convert(f : InputForm) : % ==
        pr evalForm(f, (s : Symbol) : G +-> s::G)$InputFormEvaluation(G)

)abbrev package SYMTF2 SymbolicTermFunctions2
++ Author: Bill Page, Claude
++ Date Created: 26 November 2026
++ Description:
++ The bridge of decision 0011: SymbolicTerm(R, A) is the free algebra over
++ the symbols in the variety of algebras satisfying A, so every map phi of
++ the symbols into a ring D satisfying A extends to exactly one
++ homomorphism eval(., phi) into D.  The package refuses, when it is
++ instantiated, a D that lacks the category asserting the axioms of a
++ group in A: commutativity, linear, powers and ring need a commutative
++ ring, quotients and field a field, and numerals Fraction Integer in D.
SymbolicTermFunctions2(R, A, D) : Exports == Implementation where
  R : Join(ComparableRepresentation, GcdDomain, CharacteristicZero,
           RetractableTo Integer, ConvertibleTo InputForm)
  A : List Symbol
  D : Ring
  ST ==> SymbolicTerm(R, A)
  Exports ==> with
    eval : (ST, Symbol -> D) -> D
      ++ eval(t, phi) is the image of t under the homomorphism extending
      ++ phi; operators are applied by defaultOperators of
      ++ InputFormEvaluation(D).
    eval : (ST, Symbol -> D, (Symbol, List D) -> D) -> D
      ++ eval(t, phi, psi) is the same, with operators other than the
      ++ arithmetic applied by psi.
  Implementation ==> add
    who ==> "SymbolicTermFunctions2"
    needs(g : Symbol, what : String) : Void ==
        error concat([who, ": axiom group ", string g, " needs ", what])
    for g in A repeat
        if member?(g, ['commutativity, 'linear, 'powers, 'ring]) and not (D has CommutativeRing) then
            needs(g, "a commutative ring D")
        if member?(g, ['quotients, 'field]) and not (D has Field) then
            needs(g, "a field D")
        if g = 'numerals and not (D has Algebra(Fraction Integer)) then
            needs(g, "Fraction Integer in D")

    eval(t : ST, phi : Symbol -> D) : D ==
        evalForm(form t, phi)$InputFormEvaluation(D)
    eval(t : ST, phi : Symbol -> D, psi : (Symbol, List D) -> D) : D ==
        evalForm(form t, phi, psi)$InputFormEvaluation(D)
