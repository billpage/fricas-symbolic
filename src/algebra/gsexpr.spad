-- The requirements on R and the exports are shared by
-- GeneralSymbolicExpression and SymbolicExpression.
GSEXPRRING ==> Join(ComparableRepresentation, GcdDomain, CharacteristicZero,
                    PolynomialFactorizationExplicit, RetractableTo Integer,
                    LinearlyExplicitOver Integer, ConvertibleTo InputForm,
                    PatternMatchable Integer, ConvertibleTo Pattern Integer)
GSEXPRCAT ==> Join(AlgebraicallyClosedFunctionSpace R,
                 TranscendentalFunctionCategory, PrimitiveFunctionCategory,
                 CombinatorialOpsCategory, PatternMatchable Integer,
                 ConvertibleTo Pattern Integer, ConvertibleTo InputForm) with
  value : % -> Expression R
    ++ value(x) is the element of Expression R that x denotes.
  form : % -> InputForm
    ++ form(x) is the written form of x.
  coerce : Expression R -> %
    ++ coerce(e) takes e with its own form (built structurally,
    ++ without calling the interpreter).
  check : % -> Boolean
    ++ check(x) tests the invariant of the specification: the written
    ++ form of x, evaluated structurally in Expression R, equals the
    ++ value of x.

)abbrev package SYMORD SymbolicTermOrder
++ Author: Bill Page, Claude
++ Date Created: 26 November 2026
++ Description:
++ The structural term order of the fricas-symbolic specification
++ (docs/spec/sexpr-spec.md, section 3.5): a strict total order on terms,
++ i.e. InputForm trees, used to sort the operands of commutative
++ operators in canonical forms.  Exact numerals (integers and quotients of
++ integers) come first, ordered by value with ties broken by form; then
++ float atoms; then symbols; then strings; then other atoms; then compound
++ terms, ordered by head, number of arguments and arguments.
SymbolicTermOrder() : with
    smaller? : (InputForm, InputForm) -> Boolean
      ++ smaller?(s, t) is true if s precedes t in the term order.
  == add
    INF ==> InputForm
    RN ==> Fraction Integer

    exactNumeral?(f : INF) : Boolean ==
        integer?(f)$INF => true
        atom?(f)$INF => false
        l := destruct(f)$INF
        #l = 3 and symbol?(first l)$INF and symbol(first l)$INF = '_/ and
          integer?(l.2)$INF and integer?(l.3)$INF and integer(l.3)$INF ~= 0

    exactValue(f : INF) : RN ==
        integer?(f)$INF => integer(f)$INF :: RN
        l := destruct(f)$INF
        integer(l.2)$INF / integer(l.3)$INF

    -- 0 exact numeral, 1 float atom, 2 symbol, 3 string, 4 other atom,
    -- 5 compound
    kind(f : INF) : Integer ==
        exactNumeral? f => 0
        float?(f)$INF => 1
        symbol?(f)$INF => 2
        string?(f)$INF => 3
        atom?(f)$INF => 4
        5

    smaller?(s : INF, t : INF) : Boolean ==
        ks := kind s
        kt := kind t
        ks ~= kt => ks < kt
        ks = 0 =>
            a := exactValue s
            b := exactValue t
            a ~= b => a < b
            -- equal values: an integer before a quotient; quotients by
            -- numerator (equal value and numerator give equal trees)
            integer?(s)$INF => not integer?(t)$INF
            integer?(t)$INF => false
            ds := destruct(s)$INF
            dt := destruct(t)$INF
            integer(ds.2)$INF < integer(dt.2)$INF
        ks = 1 => float(s)$INF < float(t)$INF
        ks = 2 => smaller?(symbol(s)$INF, symbol(t)$INF)$Symbol
        ks = 3 => string(s)$INF < string(t)$INF
        ks = 4 => unparse(s)$INF < unparse(t)$INF
        ls := destruct(s)$INF
        lt := destruct(t)$INF
        smaller?(first ls, first lt) => true
        smaller?(first lt, first ls) => false
        #ls ~= #lt => #ls < #lt
        for a in rest ls for b in rest lt repeat
            if smaller?(a, b) then return true
            if smaller?(b, a) then return false
        false

)abbrev package SYMGRP SymbolicAxiomGroups
++ Author: Bill Page, Claude
++ Date Created: 26 November 2026
++ Description:
++ The axiom groups of fricas-symbolic (spec section 3.4, decision 0009):
++ their names, the groups each requires, and the admissibility check that
++ GeneralSymbolicExpression and SymbolicTerm run when instantiated.
SymbolicAxiomGroups() : with
    groups : () -> List Symbol
      ++ groups() lists all known axiom groups.
    requires : Symbol -> List Symbol
      ++ requires(g) lists the groups that must accompany g.
    checkGroups : (String, List Symbol, List Symbol) -> Void
      ++ checkGroups(who, a, impl) signals an error, naming who, if a
      ++ contains an unknown group, a group not in impl (not implemented
      ++ by who), or a group without one of the groups it requires.
  == add
    groups() == ['identities, 'annihilation, 'involutions, 'numerals, 'associativity, 'commutativity, 'linear, 'powers, 'quotients, 'ring, 'field]
    requires(g : Symbol) : List Symbol ==
        g = 'linear or g = 'powers =>
            ['commutativity, 'associativity, 'identities, 'numerals]
        g = 'quotients => ['powers]
        g = 'ring => ['linear, 'powers]
        g = 'field => ['ring, 'quotients]
        empty()
    checkGroups(who : String, a : List Symbol, impl : List Symbol) : Void ==
        known := groups()
        for g in a repeat
            if not member?(g, known) then
                error concat([who, ": unknown axiom group ", string g])
            if not member?(g, impl) then
                error concat([who, ": axiom group ", string g, " is not implemented yet"])
            for r in requires g repeat
                if not member?(r, a) then
                    error concat([who, ": axiom group ", string g, " requires ", string r])
        if member?('ring, a) and member?('quotients, a) and not member?('field, a) then
            error concat([who, ": axiom groups ring and quotients together require field"])

)abbrev domain GSEXPR GeneralSymbolicExpression
++ Author: Bill Page, Claude
++ Date Created: 25 November 2026
++ Description:
++ Prototype of design (I) in the specification docs/spec/sexpr-spec.md
++ of fricas-symbolic: GeneralSymbolicExpression(R, A) is a presentation of Expression R.
++ A lists the groups of presentation axioms applied when a node is built
++ (spec section 4.1): identities, annihilation, involutions, numerals,
++ and optionally associativity (spec section 4.1.1) and commutativity
++ (spec section 3.4).
++ From Option (c) of the sexpr design review: a FunctionSpace
++ whose elements carry their written form together with their value in
++ Expression R.  Each element is a node (head, operands) with its form
++ and value.  Semantic primitives (=, zero?, numer, denom, kernels,
++ differentiate, ...) use the value, so library algorithms (integrate,
++ sum, limit, ...) see an honest FunctionSpace.  The structural
++ primitives isPlus, isTimes, isPower and the kernel of an operator node
++ follow the written tree, so rewrite rules act on the expression as
++ written.  Elements produced by library algorithms carry the form of
++ their value (head %lift) and decompose like Expression R.
GeneralSymbolicExpression(R, A) : Exports == Implementation where
  A : List Symbol
  R : GSEXPRRING
  E    ==> Expression R
  K    ==> Kernel %
  KE   ==> Kernel E
  SMP  ==> SparseMultivariatePolynomial(R, K)
  SMPE ==> SparseMultivariatePolynomial(R, KE)
  IF   ==> InputForm
  SY   ==> Symbol
  OP   ==> BasicOperator
  SUP  ==> SparseUnivariatePolynomial
  PI   ==> Pattern Integer
  PMR  ==> PatternMatchResult(Integer, %)
  RN   ==> Fraction Integer
  POW  ==> Record(val : %, exponent : Integer)
  POWE ==> Record(val : E, exponent : Integer)

  Exports ==> GSEXPRCAT

  Implementation ==> add
    -- admissibility of A (spec 3.4, decision 0009), at instantiation
    IMPL ==> ['identities, 'annihilation, 'involutions, 'numerals, 'associativity, 'commutativity, 'linear, 'powers, 'quotients, 'ring, 'field]
    checkGroups("GeneralSymbolicExpression", A, IMPL)$SymbolicAxiomGroups
    -- hd: '+, '-, '*, '/, '^ for arithmetic nodes; the operator name for
    -- operator nodes (opr holds the operator); %lift for leaves and
    -- elements made from a value.
    Rep := Record(frm : IF, val : E, hd : SY, opr : List OP, kids : List %)

    LIFT ==> '%lift
    node(f : IF, v : E, h : SY, o : List OP, l : List %) : % ==
        [f, v, h, o, l]$Rep pretend %
    rp(x : %) : Rep == x pretend Rep
    lift(e : E) : % == node(convert(e)@IF, e, LIFT, empty(), empty())
    value x == rp(x).val
    form x == rp(x).frm
    hd(x : %) : SY == rp(x).hd
    kids(x : %) : List % == rp(x).kids
    coerce(e : E) : % == lift e
    convert(x : %) : IF == form x

    fsym(s : SY) : IF == convert(s)@IF
    app(s : SY, l : List %) : IF ==
        empty? l => fsym s
        convert(concat(fsym s, [form a for a in l])$List(IF))$IF
    arith(s : SY, l : List %, v : E) : % == node(app(s, l), v, s, empty(), l)
    opnode(op : OP, l : List %, v : E) : % ==
        node(app(name op, l), v, name op, [op], l)
    -- the operator as Expression R uses it in its kernels
    eop(s : SY) : OP == operator(operator(s)$CommonOperators)$E
    u1(s : SY, x : %, v : E) : % == opnode(eop s, [x], v)
    b2(s : SY, x : %, y : %, v : E) : % == opnode(eop s, [x, y], v)

    -- kernels of % correspond one to one with kernels of E
    liftK(k : KE) : K ==
        kernel(operator k, [lift a for a in argument k], height k)$K
    lowerK(k : K) : KE ==
        kernel(operator k, [value a for a in argument k], height k)$KE
    liftP(p : SMPE) : SMP ==
        map((k : KE) : SMP +-> liftK(k)::SMP, (r : R) : SMP +-> r::SMP,
            p)$PolynomialCategoryLifting(IndexedExponents KE, KE, R, SMPE, SMP)
    lowerP(p : SMP) : SMPE ==
        map((k : K) : SMPE +-> lowerK(k)::SMPE, (r : R) : SMPE +-> r::SMPE,
            p)$PolynomialCategoryLifting(IndexedExponents K, K, R, SMP, SMPE)

    -- semantic primitives: always the value
    0 == lift(0$E)
    1 == lift(1$E)
    zero? x == zero? value x
    one? x == one? value x
    x = y == value x = value y
    smaller?(x : %, y : %) : Boolean == smaller?(value x, value y)$E
    characteristic() == 0
    belong? op == belong?(op)$E
    operator op == operator(op)$E

    coerce(n : Integer) : % == lift(n::E)
    coerce(r : R) : % == lift(r::E)
    coerce(q : RN) : % == lift(q::E)
    coerce(s : SY) : % == lift(s::E)
    coerce(k : K) : % == lift(lowerK(k)::E)
    kernels x == [liftK k for k in kernels value x]
    numer x == liftP numer value x
    denom x == liftP denom value x
    coerce(p : SMP) : % == lift(lowerP(p)::E)
    (p : SMP) / (q : SMP) == lift((lowerP p)::E / (lowerP q)::E)
    differentiate(x : %, s : SY) : % == lift differentiate(value x, s)
    retractIfCan(x : %) : Union(R, "failed") == retractIfCan(value x)@Union(R, "failed")
    retractIfCan(x : %) : Union(Integer, "failed") ==
        retractIfCan(value x)@Union(Integer, "failed")
    retractIfCan(x : %) : Union(RN, "failed") == retractIfCan(value x)@Union(RN, "failed")
    retractIfCan(x : %) : Union(SY, "failed") == retractIfCan(value x)@Union(SY, "failed")

    -- Operator evaluation must happen on the value side: the %eval
    -- property of a shared operator holds a closure for Expression R.
    -- op itself is passed on: it may be a copy carrying pattern-matching
    -- assertions (FunctionSpaceAssertions), which must not be lost.
    elt(op : OP, args : List %) : % ==
        empty? args => lift elt(op, empty()$List(E))$E
        opnode(op, args, elt(op, [value a for a in args])$E)
    kernel(op : OP, args : List %) : % ==
        empty? args => lift kernel(op, empty()$List(E))$E
        opnode(op, args, kernel(op, [value a for a in args])$E)

    -- Presentation axioms (spec section 4.1), applied at the root of a new
    -- node.  Every rule returns an operand, a numeral or -x, so the stored
    -- operands of a node are never restructured.
    ID  ==> member?('identities, A)
    ANN ==> member?('annihilation, A)
    INV ==> member?('involutions, A)
    NUM ==> member?('numerals, A)
    ASSOC ==> member?('associativity, A)
    COMM ==> member?('commutativity, A)
    LINR ==> member?('linear, A)
    POWR ==> member?('powers, A)
    QUOR ==> member?('quotients, A)
    RING ==> member?('ring, A)
    FLD ==> member?('field, A)
    lit?(x : %, n : Integer) : Boolean ==
        f := form x
        integer?(f)$IF and integer(f)$IF = n
    -- a numeral is a leaf whose value is a constant of Fraction Integer
    numeral?(x : %) : Boolean ==
        hd x = LIFT and (retractIfCan(value x)@Union(RN, "failed") case RN)
    -- Commutativity (spec 3.4, rungs P1/M1 and, with associativity, P3/M3)
    before?(a : %, b : %) : Boolean == smaller?(form a, form b)$SymbolicTermOrder
    chain(s : SY, t : %) : List % ==
        hd t = s => concat(chain(s, first kids t), [second kids t])
        [t]
    -- the normal form of a chain of operands under C and A: operands sorted
    -- by the term order; under Num the numerals (which sort first) folded
    -- into one; under Ann a product with a zero operand is 0; under Id
    -- identity elements dropped; then built left-nested
    acNormal(s : SY, l : List %) : % ==
        l := sort((a : %, b : %) : Boolean +-> before?(a, b), l)
        if NUM then
            ns := [t for t in l | numeral? t]
            if #ns > 1 then
                c := value first ns
                for t in rest ns repeat
                    if s = '_+ then c := c + value t else c := c * value t
                l := concat(lift c, [t for t in l | not numeral? t])
        unit : Integer := if s = '_+ then 0 else 1
        if s = '_* and (ANN or LINR) and any?((t : %) : Boolean +-> lit?(t, 0), l) then
            return lift(0$E)
        if ID then l := [t for t in l | not lit?(t, unit)]
        empty? l => lift(unit::E)
        r := first l
        for t in rest l repeat
            if s = '_+ then r := arith('_+, [r, t], value r + value t)
            else r := arith('_*, [r, t], value r * value t)
        r

    -- Linear combinations and power products (spec 3.4, rungs P4, M4, M5).
    -- A product is a numeral times factors b^e with distinct bases b
    -- (e >= 1 under powers, e ~= 0 under quotients); a sum is a numeral
    -- constant plus terms c*m with distinct monomials m.  Both are taken
    -- apart into these data (pfac, lfac), combined, and rebuilt in normal
    -- form (prodBuild, linBuild).
    SFAC ==> Record(b : %, e : Integer)
    SPROD  ==> Record(c : RN, fs : List SFAC)
    STERM ==> Record(m : %, c : RN)
    SLIN  ==> Record(c0 : RN, ts : List STERM)

    rnE(q : RN) : E == (numer q)::E / (denom q)::E
    numVal(t : %) : RN == retract(value t)@RN
    sameForm?(a : %, b : %) : Boolean == (form a = form b)@Boolean
    intExp(t : %) : Union(Integer, "failed") ==
        hd t = '_^ and #(kids t) = 2 and numeral?(second kids t) =>
            retractIfCan(value second kids t)@Union(Integer, "failed")
        "failed"

    facNode(b : %, e : Integer) : % ==
        e = 1 => b
        arith('_^, [b, e::%], value b ^ e)
    -- numeral c (left out if 1 and there are factors) times sorted factors
    mulChain(c : RN, l : List %) : % ==
        if c ~= 1 or empty? l then l := cons(lift rnE c, l)
        r := first l
        for t in rest l repeat r := arith('_*, [r, t], value r * value t)
        r
    mergeF(fs : List SFAC) : List SFAC ==
        ms : List SFAC := empty()
        for f in fs repeat
            nm : List SFAC := empty()
            hit := false
            for g in ms repeat
                if not hit and sameForm?(g.b, f.b) then
                    nm := cons([g.b, g.e + f.e]$SFAC, nm)
                    hit := true
                else nm := cons(g, nm)
            if not hit then nm := cons(f, nm)
            ms := nm
        [g for g in ms | g.e ~= 0]
    prodBuild(c : RN, fs : List SFAC) : % ==
        c = 0 => lift(0$E)
        ms := mergeF fs
        srt := (l : List %) : List % +-> sort((a : %, b : %) : Boolean +-> before?(a, b), l)
        pl := srt [facNode(g.b, g.e) for g in ms | g.e > 0]
        nl := srt [facNode(g.b, - g.e) for g in ms | g.e < 0]
        num := mulChain(c, pl)
        empty? nl => num
        den := mulChain(1, nl)
        arith('_/, [num, den], value num / value den)
    pfac(t : %) : SPROD ==
        numeral? t => [numVal t, empty()]
        hd t = '_* =>
            c : RN := 1
            fs : List SFAC := empty()
            for f in chain('_*, t) repeat
                r := pfac f
                c := c * r.c
                fs := concat(fs, r.fs)
            [c, fs]
        QUOR and hd t = '_/ =>
            n := pfac first kids t
            d := pfac second kids t
            [n.c / d.c, concat(n.fs, [[f.b, - f.e]$SFAC for f in d.fs])]
        (u := intExp t) case Integer and (u::Integer >= 1 or QUOR) =>
            k := u::Integer
            r := pfac first kids t
            [r.c ^ k, [[f.b, f.e * k]$SFAC for f in r.fs]]
        [1, [[t, 1]$SFAC]]

    sum?(t : %) : Boolean == hd t = '_+ or hd t = '_-
    -- a term as (monomial, coefficient)
    coefMono(t : %) : STERM ==
        POWR =>
            r := pfac t
            [prodBuild(1, r.fs), r.c]
        hd t = '_* =>
            fs := chain('_*, t)
            numeral? first fs =>
                rs := rest fs
                m := first rs
                for f in rest rs repeat m := arith('_*, [m, f], value m * value f)
                [m, numVal first fs]
            [t, 1]
        [t, 1]
    mergeT(ts : List STERM) : List STERM ==
        ms : List STERM := empty()
        for t in ts repeat
            nm : List STERM := empty()
            hit := false
            for g in ms repeat
                if not hit and sameForm?(g.m, t.m) then
                    nm := cons([g.m, g.c + t.c]$STERM, nm)
                    hit := true
                else nm := cons(g, nm)
            if not hit then nm := cons(t, nm)
            ms := nm
        [g for g in ms | g.c ~= 0]
    -- the normal form of c0 + sum of c*m: terms sorted by monomial, the
    -- first negated if its coefficient is negative, the others added or
    -- subtracted, the constant last
    linBuild(c0 : RN, ts : List STERM) : % ==
        ms := sort((a : STERM, b : STERM) : Boolean +-> before?(a.m, b.m), mergeT ts)
        empty? ms => lift rnE c0
        acc : % := lift(0$E)
        firstTerm := true
        for t in ms repeat
            pc := abs(t.c)
            -- c*m built directly under powers, so that ring (whose * calls
            -- linBuild) does not recurse
            trm : % :=
                pc = 1 => t.m
                POWR => (pm := pfac t.m; prodBuild(pc * pm.c, mergeF pm.fs))
                lift(rnE pc) * t.m
            if firstTerm then
                if t.c > 0 then acc := trm
                else acc := arith('_-, [trm], - value trm)
                firstTerm := false
            else
                if t.c > 0 then acc := arith('_+, [acc, trm], value acc + value trm)
                else acc := arith('_-, [acc, trm], value acc - value trm)
        c0 = 0 => acc
        cn := lift rnE abs(c0)
        c0 > 0 => arith('_+, [acc, cn], value acc + value cn)
        arith('_-, [acc, cn], value acc - value cn)
    lfac(t : %) : SLIN ==
        numeral? t => [numVal t, empty()]
        hd t = '_+ =>
            a := lfac first kids t
            b := lfac second kids t
            [a.c0 + b.c0, concat(a.ts, b.ts)]
        hd t = '_- and #(kids t) = 2 =>
            a := lfac first kids t
            b := lfac second kids t
            [a.c0 - b.c0, concat(a.ts, [[r.m, - r.c]$STERM for r in b.ts])]
        hd t = '_- =>
            a := lfac first kids t
            [- a.c0, [[r.m, - r.c]$STERM for r in a.ts]]
        r := coefMono t
        numeral? r.m => [r.c * numVal r.m, empty()]
        [0, [r]]
    scaled(c : RN, x : %) : % ==
        a := lfac x
        linBuild(c * a.c0, [[r.m, c * r.c]$STERM for r in a.ts])
    -- a product in normal form, with a numeral times a sum distributed
    -- under linear (2*(x+y) = 2*x+2*y)
    mulNormal(c : RN, fs : List SFAC) : % ==
        ms := mergeF fs
        LINR and c ~= 1 and #ms = 1 and (first ms).e = 1 and sum?((first ms).b) =>
            scaled(c, (first ms).b)
        prodBuild(c, ms)
    -- Polynomials and reduced fractions over the atoms (spec 3.4, rungs
    -- Ring and Field).  The atoms of both operands get fresh symbols; the
    -- operation is done in Fraction Polynomial RN, whose gcd reduces the
    -- fraction; the result is rebuilt with linBuild and prodBuild, scaled
    -- so that the first term of the denominator has coefficient 1.
    PRN ==> Polynomial RN
    FPR ==> Fraction PRN
    rdiv?(t : %) : Boolean == FLD or numeral? second kids t
    rpow(t : %) : Union(Integer, "failed") ==
        e := intExp t
        e case "failed" => "failed"
        n := e::Integer
        n >= 0 or FLD => n
        "failed"
    addAtom(l : List %, t : %) : List % ==
        any?((s : %) : Boolean +-> sameForm?(s, t), l) => l
        concat(l, [t])
    ratoms(l : List %, t : %) : List % ==
        numeral? t => l
        h := hd t
        h = '_+ or h = '_- or h = '_* or (h = '_/ and rdiv? t) =>
            for k in kids t repeat l := ratoms(l, k)
            l
        h = '_^ and rpow(t) case Integer => ratoms(l, first kids t)
        addAtom(l, t)
    atomSyms(al : List %) : List Symbol ==
        [concat("%%st", string(i)$String)::Symbol for i in 1..#al]
    toF(t : %, al : List %, sy : List Symbol) : FPR ==
        numeral? t => (numVal(t)::PRN)::FPR
        h := hd t
        ks := kids t
        h = '_+ =>
            r := toF(first ks, al, sy)
            for k in rest ks repeat r := r + toF(k, al, sy)
            r
        h = '_- and #ks = 1 => - toF(first ks, al, sy)
        h = '_- => toF(first ks, al, sy) - toF(second ks, al, sy)
        h = '_* =>
            r := toF(first ks, al, sy)
            for k in rest ks repeat r := r * toF(k, al, sy)
            r
        h = '_/ and rdiv? t => toF(first ks, al, sy) / toF(second ks, al, sy)
        h = '_^ and (n := rpow t) case Integer =>
            toF(first ks, al, sy) ^ (n::Integer)
        for i in 1..#al repeat
            if sameForm?(al.i, t) then return (sy.i::PRN)::FPR
        error "GeneralSymbolicExpression: atom not found"
    toLin(p : PRN, al : List %, sy : List Symbol) : SLIN ==
        c0 : RN := 0
        ts : List STERM := empty()
        for m in monomials p repeat
            vs := variables m
            if empty? vs then c0 := c0 + leadingCoefficient m
            else
                fs := [[al.position(v, sy), degree(m, v)::Integer]$SFAC for v in vs]
                ts := cons([prodBuild(1, fs), leadingCoefficient m]$STERM, ts)
        [c0, ts]
    -- the fraction p/q scaled by k: integer coefficients with no common
    -- factor, the first term of q (in term order) positive; a constant q
    -- is divided into p
    fromF(f : FPR, al : List %, sy : List Symbol) : % ==
        lp := toLin(numer f, al, sy)
        lq := toLin(denom f, al, sy)
        empty? lq.ts =>
            linBuild(lp.c0 / lq.c0, [[t.m, t.c / lq.c0]$STERM for t in lp.ts])
        cs : List RN := concat([lp.c0, lq.c0], concat([t.c for t in lp.ts], [t.c for t in lq.ts]))
        d : Integer := 1
        for c in cs repeat d := lcm(d, denom c)
        n : Integer := 0
        for c in cs repeat n := gcd(n, numer(c * d))
        k : RN := d / n
        t1 := first lq.ts
        for t in rest lq.ts repeat
            if before?(t.m, t1.m) then t1 := t
        if t1.c < 0 then k := - k
        num := linBuild(k * lp.c0, [[t.m, k * t.c]$STERM for t in lp.ts])
        den := linBuild(k * lq.c0, [[t.m, k * t.c]$STERM for t in lq.ts])
        arith('_/, [num, den], value num / value den)
    ring1(x : %, f : FPR -> FPR) : % ==
        al := ratoms(empty(), x)
        sy := atomSyms al
        fromF(f toF(x, al, sy), al, sy)
    ring2(x : %, y : %, f : (FPR, FPR) -> FPR) : % ==
        al := ratoms(ratoms(empty(), x), y)
        sy := atomSyms al
        fromF(f(toF(x, al, sy), toF(y, al, sy)), al, sy)

    x : % + y : % ==
        v := value x + value y
        NUM and numeral? x and numeral? y => lift v
        RING => ring2(x, y, (a : FPR, b : FPR) : FPR +-> a + b)
        LINR =>
            a := lfac x
            b := lfac y
            linBuild(a.c0 + b.c0, concat(a.ts, b.ts))
        ID and lit?(x, 0) => y
        ID and lit?(y, 0) => x
        COMM and ASSOC => acNormal('_+, concat(chain('_+, x), chain('_+, y)))
        -- Assoc (spec 4.1.1): (A) x+(y1+y2) -> (x+y1)+y2, and its completion
        -- with Num, (AN) (x1+n)+m -> x1+(n+m), through + itself, so the new
        -- inner node is normalised too
        ASSOC and hd y = '_+ => (x + first kids y) + second kids y
        ASSOC and NUM and numeral? y and hd x = '_+ and
          numeral? second kids x => first kids x + (second kids x + y)
        COMM and before?(y, x) => arith('_+, [y, x], v)
        arith('_+, [x, y], v)
    - x : % ==
        v := - value x
        NUM and numeral? x => lift v
        RING => ring1(x, (f : FPR) : FPR +-> - f)
        LINR => scaled(-1, x)
        INV and hd x = '_- and #(kids x) = 1 => first kids x
        arith('_-, [x], v)
    x : % - y : % ==
        v := value x - value y
        NUM and numeral? x and numeral? y => lift v
        RING => ring2(x, y, (a : FPR, b : FPR) : FPR +-> a - b)
        LINR =>
            a := lfac x
            b := lfac y
            linBuild(a.c0 - b.c0, concat(a.ts, [[r.m, - r.c]$STERM for r in b.ts]))
        ID and lit?(y, 0) => x
        ID and lit?(x, 0) => - y
        arith('_-, [x, y], v)
    x : % * y : % ==
        v := value x * value y
        NUM and numeral? x and numeral? y => lift v
        ANN and (lit?(x, 0) or lit?(y, 0)) => lift(0$E)
        ID and lit?(x, 1) => y
        ID and lit?(y, 1) => x
        RING => ring2(x, y, (a : FPR, b : FPR) : FPR +-> a * b)
        POWR =>
            a := pfac x
            b := pfac y
            mulNormal(a.c * b.c, concat(a.fs, b.fs))
        COMM and ASSOC and LINR =>
            r := acNormal('_*, concat(chain('_*, x), chain('_*, y)))
            cm := coefMono r
            cm.c ~= 1 and sum?(cm.m) => scaled(cm.c, cm.m)
            r
        COMM and ASSOC => acNormal('_*, concat(chain('_*, x), chain('_*, y)))
        ASSOC and hd y = '_* => (x * first kids y) * second kids y
        ASSOC and NUM and numeral? y and hd x = '_* and
          numeral? second kids x => first kids x * (second kids x * y)
        COMM and before?(y, x) => arith('_*, [y, x], v)
        arith('_*, [x, y], v)
    x : % / y : % ==
        v := value x / value y
        NUM and numeral? x and numeral? y => lift v
        RING and (FLD or numeral? y) => ring2(x, y, (a : FPR, b : FPR) : FPR +-> a / b)
        QUOR =>
            a := pfac x
            b := pfac y
            mulNormal(a.c / b.c, concat(a.fs, [[f.b, - f.e]$SFAC for f in b.fs]))
        ID and lit?(y, 1) => x
        INV and lit?(x, 1) and hd y = '_/ and lit?(first kids y, 1) =>
            second kids y
        arith('_/, [x, y], v)
    n : Integer * x : % == (n::%) * x
    n : NonNegativeInteger * x : % == (n::Integer) * x
    n : PositiveInteger * x : % == (n::Integer) * x
    -- right multiplication keeps the written order (G1, Disp): the
    -- category defaults would compute x*n as n*x
    x : % * n : Integer == x * (n::%)
    x : % * r : R == x * (r::%)
    r : R * x : % == (r::%) * x
    x : % * q : RN == x * (q::%)
    q : RN * x : % == (q::%) * x
    x : % ^ n : Integer ==
        v := value x ^ n
        NUM and numeral? x => lift v
        ID and n = 1 => x
        ID and n = 0 => lift(1$E)
        RING and (n >= 0 or FLD) => ring1(x, (f : FPR) : FPR +-> f ^ n)
        POWR and (n >= 1 or (QUOR and n ~= 0)) =>
            a := pfac x
            mulNormal(a.c ^ n, [[f.b, f.e * n]$SFAC for f in a.fs])
        arith('_^, [x, n::%], v)
    x : % ^ n : NonNegativeInteger == x ^ (n::Integer)
    x : % ^ n : PositiveInteger == x ^ (n::Integer)
    x : % ^ q : RN == arith('_^, [x, q::%], value x ^ q)
    x : % ^ y : % ==
        (n := retractIfCan(value y)@Union(Integer, "failed")) case Integer
          and numeral? y => x ^ (n::Integer)
        arith('_^, [x, y], value x ^ value y)
    nthRoot(x : %, n : Integer) == b2('nthRoot, x, n::%, nthRoot(value x, n))
    sqrt x == u1('sqrt, x, sqrt value x)

    -- structural primitives: the written tree
    plusTerms(x : %) : List % ==
        h := hd x
        h = '_+ => concat([plusTerms a for a in kids x])
        h = '_- and #(kids x) = 2 =>
            concat(plusTerms first kids x, plusTerms(- second kids x))
        [x]
    -- Each node is classified by its written shape: a sum, a product
    -- (a/b counts as a*b^(-1)), an integer power, a kernel (an operator
    -- node whose value is that kernel), or none of these (also any node
    -- whose value is a constant).  A node answers
    -- only the question matching its class; a node of no class (leaves,
    -- results of library algorithms, operator nodes whose value
    -- simplified) answers like its value in Expression R.
    intpow?(x : %) : Boolean ==
        hd x = '_^ and
          (retractIfCan(second kids x)@Union(Integer, "failed") case Integer)
    opkernel?(x : %) : Boolean ==
        empty?(rp(x).opr) => false
        (k := retractIfCan(value x)@Union(KE, "failed")) case "failed" => false
        name(operator(k::KE)) = hd x and #(argument(k::KE)) = #(kids x)
    cls(x : %) : SY ==
        -- constants never decompose by their written shape
        retractIfCan(value x)@Union(R, "failed") case R => 'none
        h := hd x
        h = '_+ or (h = '_- and #(kids x) = 2) => 'plus
        h = '_* or h = '_/ or (h = '_- and #(kids x) = 1) => 'times
        intpow? x => 'power
        opkernel? x => 'kernel
        'none
    timesFactors(x : %) : List % ==
        h := hd x
        h = '_* => concat([timesFactors a for a in kids x])
        h = '_/ =>
            m1 : Integer := -1
            concat(timesFactors first kids x, [(second kids x) ^ m1])
        h = '_- and #(kids x) = 1 =>
            concat(lift(-(1$E)), timesFactors first kids x)
        [x]
    isPlus x ==
        c := cls x
        c = 'plus => plusTerms x
        c ~= 'none => "failed"
        (u := isPlus(value x)$E) case "failed" => "failed"
        [lift t for t in u::List(E)]
    isTimes x ==
        c := cls x
        c = 'times => timesFactors x
        c ~= 'none => "failed"
        (u := isTimes(value x)$E) case "failed" => "failed"
        [lift t for t in u::List(E)]
    isPower x ==
        c := cls x
        c = 'power =>
            n := retractIfCan(second kids x)@Union(Integer, "failed")
            [first kids x, n::Integer]$POW
        c ~= 'none => "failed"
        (u := isPower(value x)$E) case "failed" => "failed"
        r := u::POWE
        [lift r.val, r.exponent]$POW
    retractIfCan(x : %) : Union(K, "failed") ==
        (k := retractIfCan(value x)@Union(KE, "failed")) case "failed" =>
            "failed"
        ke := k::KE
        -- an operator node keeps its written operands in its kernel
        opkernel? x => kernel(operator ke, kids x, height ke)$K
        liftK ke

    -- rebuild an operator node through this domain's own function, so
    -- that Expression R evaluates it (elt only evaluates operators that
    -- carry an %eval property, and nthRoot or sqrt carry none)
    reapply(x : %, l : List %) : % ==
        s := hd x
        a := first l
        s = 'exp => exp a
        s = 'log => log a
        s = 'sin => sin a
        s = 'cos => cos a
        s = 'tan => tan a
        s = 'cot => cot a
        s = 'sec => sec a
        s = 'csc => csc a
        s = 'asin => asin a
        s = 'acos => acos a
        s = 'atan => atan a
        s = 'acot => acot a
        s = 'asec => asec a
        s = 'acsc => acsc a
        s = 'sinh => sinh a
        s = 'cosh => cosh a
        s = 'tanh => tanh a
        s = 'coth => coth a
        s = 'sech => sech a
        s = 'csch => csch a
        s = 'asinh => asinh a
        s = 'acosh => acosh a
        s = 'atanh => atanh a
        s = 'acoth => acoth a
        s = 'asech => asech a
        s = 'acsch => acsch a
        s = 'sqrt => sqrt a
        s = 'factorial => factorial a
        s = 'nthRoot => nthRoot(a, retract(second l)@Integer)
        s = 'binomial => binomial(a, second l)
        s = 'permutation => permutation(a, second l)
        elt(first(rp(x).opr), l)

    -- substitution rebuilds the written tree
    substT(x : %, ls : List SY, lv : List %) : % ==
        h := hd x
        h = LIFT =>
            (s := retractIfCan(value x)@Union(SY, "failed")) case SY =>
                (p := position(s::SY, ls)) >= minIndex(ls) => lv.p
                x
            lift eval(value x, [kernel(t)$KE for t in ls],
                      [value w for w in lv])$E
        l := [substT(a, ls, lv) for a in kids x]
        h = '_+ => first l + second l
        h = '_- =>
            #l = 1 => - first l
            first l - second l
        h = '_* => first l * second l
        h = '_/ => first l / second l
        h = '_^ => first l ^ second l
        reapply(x, l)
    subst(x : %, lk : List K, lv : List %) : % ==
        empty? lk => x
        ls : List SY := empty()
        for k in lk repeat
            u := symbolIfCan k
            if u case "failed" then
                return lift eval(value x, [lowerK j for j in lk],
                                 [value w for w in lv])$E
            ls := concat(ls, u::SY)
        substT(x, ls, lv)
    eval(x : %, lk : List K, lv : List %) : % == subst(x, lk, lv)

    -- elementary functions
    pi() == lift(pi()$E)
    exp x == u1('exp, x, exp value x)
    log x == u1('log, x, log value x)
    sin x == u1('sin, x, sin value x)
    cos x == u1('cos, x, cos value x)
    tan x == u1('tan, x, tan value x)
    cot x == u1('cot, x, cot value x)
    sec x == u1('sec, x, sec value x)
    csc x == u1('csc, x, csc value x)
    asin x == u1('asin, x, asin value x)
    acos x == u1('acos, x, acos value x)
    atan x == u1('atan, x, atan value x)
    acot x == u1('acot, x, acot value x)
    asec x == u1('asec, x, asec value x)
    acsc x == u1('acsc, x, acsc value x)
    sinh x == u1('sinh, x, sinh value x)
    cosh x == u1('cosh, x, cosh value x)
    tanh x == u1('tanh, x, tanh value x)
    coth x == u1('coth, x, coth value x)
    sech x == u1('sech, x, sech value x)
    csch x == u1('csch, x, csch value x)
    asinh x == u1('asinh, x, asinh value x)
    acosh x == u1('acosh, x, acosh value x)
    atanh x == u1('atanh, x, atanh value x)
    acoth x == u1('acoth, x, acoth value x)
    asech x == u1('asech, x, asech value x)
    acsch x == u1('acsch, x, acsch value x)

    -- algebraic functions
    supv(p : SUP %) : SUP E == map(value, p)$SparseUnivariatePolynomialFunctions2(%, E)
    rootOf(p : SUP %, y : SY) : % == lift rootOf(supv p, y)$E
    rootsOf(p : SUP %, y : SY) : List % == [lift r for r in rootsOf(supv p, y)$E]
    zeroOf(p : SUP %, y : SY) : % == lift zeroOf(supv p, y)$E
    zerosOf(p : SUP %, y : SY) : List % == [lift r for r in zerosOf(supv p, y)$E]

    -- combinatorial and primitive functions
    sbv(s : SegmentBinding %) : SegmentBinding E ==
        map(value, s)$SegmentBindingFunctions2(%, E)
    factorial x == u1('factorial, x, factorial value x)
    binomial(x, y) == b2('binomial, x, y, binomial(value x, value y))
    permutation(x, y) == b2('permutation, x, y, permutation(value x, value y))
    factorials x == lift factorials value x
    factorials(x, s) == lift factorials(value x, s)
    summation(x : %, s : SY) : % == lift summation(value x, s)
    summation(x : %, s : SegmentBinding %) : % == lift summation(value x, sbv s)
    product(x : %, s : SY) : % == lift product(value x, s)
    product(x : %, s : SegmentBinding %) : % == lift product(value x, sbv s)
    integral(x : %, s : SY) : % == lift integral(value x, s)
    integral(x : %, s : SegmentBinding %) : % == lift integral(value x, sbv s)

    -- display (spec section 5.4): built from the written tree; leaves and
    -- results of library algorithms show Expression's own output
    -- Explicit parentheses, so that the displayed text reads back as the
    -- stored form (spec property Disp): the 1-D formatter of FriCAS 1.4.0
    -- prints a-(b+c) as a-b+c, a*(b*c) as a*b*c and a/(b/c) as a/b/c, and
    -- OutputForm's unary minus cancels -(-a).
    -- prec: 1 sums, differences, negations; 2 products, quotients;
    -- 3 powers; 4 atoms and function applications.
    precF(f : IF) : Integer ==
        integer?(f)$IF => (integer(f)$IF < 0 => 1; 4)
        atom?(f)$IF => 4
        l := destruct(f)$IF
        not symbol?(first l)$IF => 4
        s := symbol(first l)$IF
        s = '_+ or s = '_- => 1
        s = '_* or s = '_/ => 2
        s = '_^ => 3
        4
    pOut(x : %, p : Integer) : OutputForm ==
        precF(form x) <= p => paren(x::OutputForm)
        x::OutputForm
    coerce(x : %) : OutputForm ==
        h := hd x
        h = LIFT => (value x)::OutputForm
        l := kids x
        h = '_+ => (first l)::OutputForm + pOut(second l, 1)
        h = '_- =>
            #l = 1 => - pOut(first l, 1)
            (first l)::OutputForm - pOut(second l, 1)
        h = '_* => pOut(first l, 1) * pOut(second l, 2)
        h = '_/ =>
            r := second l
            n := first l
            -- a numerator with a leading unary minus needs parentheses,
            -- or -a/b reads back as -(a/b) (Disp)
            no := (hd n = '_- and #(kids n) = 1 => paren(n::OutputForm); n::OutputForm)
            hd r = '_/ => no / paren(r::OutputForm)
            no / r::OutputForm
        h = '_^ => pOut(first l, 3) ^ (second l)::OutputForm
        prefix(h::OutputForm, [a::OutputForm for a in l])

    -- structural evaluation of a written form in Expression R (no
    -- interpreter), for the invariant check
    evalF(f : IF) : E ==
        integer?(f)$IF => integer(f)$IF :: E
        symbol?(f)$IF => symbol(f)$IF :: E
        l := destruct(f)$IF
        s := symbol(first l)$IF
        a := [evalF g for g in rest l]
        s = '_+ => reduce(_+, a)
        s = '_- =>
            #a = 1 => - first a
            first a - second a
        s = '_* => reduce(_*, a)
        s = '_/ => first a / second a
        s = '_^ =>
            (n := retractIfCan(second a)@Union(Integer, "failed")) case Integer =>
                first a ^ (n::Integer)
            first a ^ second a
        s = 'nthRoot =>
            nthRoot(first a, retract(second a)@Integer)
        s = 'exp => exp(first a)$E
        s = 'log => log(first a)$E
        s = 'sin => sin(first a)$E
        s = 'cos => cos(first a)$E
        s = 'tan => tan(first a)$E
        s = 'cot => cot(first a)$E
        s = 'sec => sec(first a)$E
        s = 'csc => csc(first a)$E
        s = 'asin => asin(first a)$E
        s = 'acos => acos(first a)$E
        s = 'atan => atan(first a)$E
        s = 'acot => acot(first a)$E
        s = 'asec => asec(first a)$E
        s = 'acsc => acsc(first a)$E
        s = 'sinh => sinh(first a)$E
        s = 'cosh => cosh(first a)$E
        s = 'tanh => tanh(first a)$E
        s = 'coth => coth(first a)$E
        s = 'sech => sech(first a)$E
        s = 'csch => csch(first a)$E
        s = 'asinh => asinh(first a)$E
        s = 'acosh => acosh(first a)$E
        s = 'atanh => atanh(first a)$E
        s = 'acoth => acoth(first a)$E
        s = 'asech => asech(first a)$E
        s = 'acsch => acsch(first a)$E
        s = 'sqrt => sqrt(first a)$E
        s = 'factorial => factorial(first a)$E
        s = 'binomial => binomial(first a, second a)$E
        s = 'permutation => permutation(first a, second a)$E
        elt(operator(operator(s)$CommonOperators)$E, a)$E
    check x == evalF(form x) = value x

    -- pattern matching
    convert(x : %) : PI == convert(value x)@PI
    patternMatch(x : %, p : PI, l : PMR) : PMR ==
        patternMatch(x, p, l)$PatternMatchFunctionSpace(Integer, R, %)

)abbrev domain SEXPR SymbolicExpression
++ Author: Bill Page, Claude
++ Date Created: 26 November 2026
++ Description:
++ SymbolicExpression(R) is GeneralSymbolicExpression(R, A) with A the
++ presentation axioms [identities, annihilation, involutions, numerals]:
++ expressions that keep their written form, apart from identity elements,
++ products with zero, double negations and reciprocals, and arithmetic on
++ numerals, and whose equality is that of Expression R.
SymbolicExpression(R) : Exports == Implementation where
  R : GSEXPRRING
  Exports ==> GSEXPRCAT
  Implementation ==> GeneralSymbolicExpression(R, ['identities, 'annihilation, 'involutions, 'numerals])
