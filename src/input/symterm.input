-- Tests for SymbolicTerm(R, A) (src/algebra/symterm.spad): design (II) of
-- the specification docs/spec/sexpr-spec.md, sections 3.2 and 3.4, with
-- axiom groups named in a list (decision 0009).  Equality is equality
-- modulo A: identity of normal forms.
--
-- Run with `make check` (also run by CI), or in a FriCAS session:
--   )compile src/algebra/gsexpr.spad
--   )compile src/algebra/symterm.spad
--   )read src/input/symterm.input
-- testsuite and testcase clear macros as well as variables, so each test
-- case writes the domain in full.

)set break resume
)expose UnittestCount UnittestAux Unittest

testsuite "SymbolicTerm"

testcase "no groups: P0/M0, nothing is rewritten (spec 3.4, G3)"
(x, y) : SymbolicTerm(Integer, [])
x := 'x; y := 'y
testTrue("not (x+0 = x)@Boolean")
testTrue("not (0*x = 0)@Boolean")
testTrue("not ((1::SymbolicTerm(Integer, []))+2 = 3)@Boolean")
testTrue("not (-(-x) = x)@Boolean")
testTrue("not (x+y = y+x)@Boolean")
testTrue("(x+y = x+y)@Boolean")
testTrue("(unparse(form(x+0)) = _"x+0_")@Boolean")
xftestTrue("(x+0 = x)@Boolean")

testcase "A_P groups: equality modulo identities, annihilation, involutions, numerals"
(x, y) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals])
x := 'x; y := 'y
testTrue("(x+0 = x)@Boolean")
testTrue("(1*x = x)@Boolean")
testTrue("(x^1 = x)@Boolean")
testTrue("(0*x = 0)@Boolean")
testTrue("(-(-x) = x)@Boolean")
testTrue("(1/(1/x) = x)@Boolean")
testTrue("((1::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals]))+2 = 3)@Boolean")
-- no commutativity or associativity: these stay different
testTrue("not (x+y = y+x)@Boolean")
testTrue("not ((x+1)+2 = x+3)@Boolean")
testTrue("not (x+(y+1) = (x+y)+1)@Boolean")
-- equality modulo A is not equality of value
testTrue("not ((x+1)^2 - (x^2+2*x+1) = 0)@Boolean")
testTrue("zero?((((x+1)^2 - (x^2+2*x+1))::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals]))::Expression(Integer))")
xftestTrue("(x+y = y+x)@Boolean")

testcase "A_P with associativity (spec 4.1.1)"
(w, x, y) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity])
w := 'w; x := 'x; y := 'y
testTrue("(x+(y+w) = (x+y)+w)@Boolean")
testTrue("(x*(y*w) = (x*y)*w)@Boolean")
testTrue("((x+1)+2 = x+3)@Boolean")
testTrue("(x+(1+2) = x+3)@Boolean")
testTrue("not ((1+x)+2 = x+3)@Boolean")
testTrue("not (x+y = y+x)@Boolean")

testcase "conversion to Expression keeps the value (spec 3.4, N3)"
(x, y) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity])
x := 'x; y := 'y
testTrue("(((x+y)+0)::Expression(Integer) = (y+x)::Expression(Integer))@Boolean")
testTrue("((x*(y*1))::Expression(Integer) = (y*x)::Expression(Integer))@Boolean")
testTrue("((sin(x)^2)::Expression(Integer) = sin(('x)::Expression(Integer))^2)@Boolean")

testcase "display reads back as the normal form (Disp)"
(x, y) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity])
x := 'x; y := 'y
rt(t : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity])) : Boolean == (parse(concat(lines(formatExpression(precondition(t::OutputForm)$OutputFormTools)$Format1D)))$InputForm = form t)@Boolean
testTrue("rt(x+(y+1)) and rt(x-(y-1)) and rt(x*(y/2)) and rt(sin(x+y)^2)")

testcase "display reads back as the normal form under linear, powers, quotients (Disp)"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients])
x := 'x; y := 'y
rt(t : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients])) : Boolean == (parse(concat(lines(formatExpression(precondition(t::OutputForm)$OutputFormTools)$Format1D)))$InputForm = form t)@Boolean
testTrue("rt(y-2*x+1) and rt(3-x) and rt(-x-1) and rt(x/(2*y)) and rt(x/(y*x^2)) and rt(2*x*y+3*y*x) and rt((1/2)*x+y) and rt(x^(-1)) and rt(-(x/y)) and rt(sin(x-y)^(-2)*(x+1)) and rt(x-(1/3)*y^2)")

testcase "admissibility (spec 3.4, decision 0009)"
-- unknown group, not yet implemented group, both constructors
testLibraryError("('x)::SymbolicTerm(Integer, [identity])")
testLibraryError("('x)::SymbolicTerm(Integer, [ring, linear, powers, commutativity, associativity, identities, numerals])")
testLibraryError("('x)::GeneralSymbolicExpression(Integer, [identity])")
testLibraryError("('x)::GeneralSymbolicExpression(Integer, [ring, linear, powers, commutativity, associativity, identities, numerals])")
-- requirements, checked with every group taken as implemented
testLibraryError("checkGroups(_"test_", [linear], groups())$SymbolicAxiomGroups")
testLibraryError("checkGroups(_"test_", [quotients, commutativity, associativity, identities, numerals], groups())$SymbolicAxiomGroups")
testTrue("(checkGroups(_"test_", [linear, commutativity, associativity, identities, numerals], groups())$SymbolicAxiomGroups; true)")
testTrue("(checkGroups(_"test_", [field, ring, quotients, powers, linear, commutativity, associativity, identities, numerals], groups())$SymbolicAxiomGroups; true)")
-- admissible lists are accepted
testTrue("(unparse(form(('x)::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity]))) = _"x_")@Boolean")
testTrue("(unparse(form(('x)::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals]))) = _"x_")@Boolean")

testcase "commutativity alone: P1/M1, operands of each node sorted (spec 3.4)"
(x, y, z) : SymbolicTerm(Integer, [commutativity])
x := 'x; y := 'y; z := 'z
testTrue("(x+y = y+x)@Boolean")
testTrue("(x*y = y*x)@Boolean")
testTrue("((x+y)+z = z+(y+x))@Boolean")
testTrue("not ((x+y)+z = x+(y+z))@Boolean")
testTrue("not (x+0 = x)@Boolean")
testTrue("not ((1::SymbolicTerm(Integer, [commutativity]))+2 = 3)@Boolean")
testTrue("(unparse(form(y+x)) = _"x+y_")@Boolean")
xftestTrue("(unparse(form(y+x)) = _"y+x_")@Boolean")
-- swapping the operands at any node of a three-leaf tree gives one form
lc : List SymbolicTerm(Integer, [commutativity]) := [('x)::SymbolicTerm(Integer, [commutativity]), ('y)::SymbolicTerm(Integer, [commutativity]), ('z)::SymbolicTerm(Integer, [commutativity]), 1::SymbolicTerm(Integer, [commutativity])]
ncomb : Integer := 0
nsw : Integer := 0
for a in lc repeat
  for b in lc repeat
    for c in lc repeat
      ncomb := ncomb + 1
      g1 := [unparse(form t) for t in [(a+b)+c, (b+a)+c, c+(a+b), c+(b+a), (a*b)*c, (b*a)*c, c*(a*b), c*(b*a)]]
      g2 := [unparse(form t) for t in [a+(b+c), a+(c+b), (b+c)+a, (c+b)+a, a*(b*c), a*(c*b), (b*c)*a, (c*b)*a]]
      if #removeDuplicates(first(g1, 4)) > 1 or #removeDuplicates(rest(g1, 4)) > 1 then nsw := nsw + 1
      if #removeDuplicates(first(g2, 4)) > 1 or #removeDuplicates(rest(g2, 4)) > 1 then nsw := nsw + 1
testTrue("(ncomb = 64)@Boolean")
testTrue("(nsw = 0)@Boolean")

testcase "commutativity with associativity: P3/M3, all orders and groupings agree (spec 3.4)"
pl(u : SymbolicTerm(Integer, [commutativity, associativity]), v : SymbolicTerm(Integer, [commutativity, associativity])) : SymbolicTerm(Integer, [commutativity, associativity]) == u + v
ml(u : SymbolicTerm(Integer, [commutativity, associativity]), v : SymbolicTerm(Integer, [commutativity, associativity])) : SymbolicTerm(Integer, [commutativity, associativity]) == u * v
brs(op : (SymbolicTerm(Integer, [commutativity, associativity]), SymbolicTerm(Integer, [commutativity, associativity])) -> SymbolicTerm(Integer, [commutativity, associativity]), a : SymbolicTerm(Integer, [commutativity, associativity]), b : SymbolicTerm(Integer, [commutativity, associativity]), c : SymbolicTerm(Integer, [commutativity, associativity]), d : SymbolicTerm(Integer, [commutativity, associativity])) : List SymbolicTerm(Integer, [commutativity, associativity]) == [op(op(op(a,b),c),d), op(op(a,op(b,c)),d), op(op(a,b),op(c,d)), op(a,op(op(b,c),d)), op(a,op(b,op(c,d)))]
perms(l : List Integer) : List List Integer == if empty? l then [empty()$List(Integer)] else concat [[cons(l.i, q) for q in perms(delete(l, i))] for i in 1..#l]
P := perms([1, 2, 3, 4])
lv : List SymbolicTerm(Integer, [commutativity, associativity]) := [('x)::SymbolicTerm(Integer, [commutativity, associativity]), ('y)::SymbolicTerm(Integer, [commutativity, associativity]), 1::SymbolicTerm(Integer, [commutativity, associativity]), 2::SymbolicTerm(Integer, [commutativity, associativity])]
n := #lv
nbad : Integer := 0
nms : Integer := 0
for i in 1..n repeat
  for j in i..n repeat
    for k in j..n repeat
      for m in k..n repeat
        ms := [lv.i, lv.j, lv.k, lv.m]
        nms := nms + 1
        for op in [pl, ml] repeat
          fs := concat [[unparse(form t) for t in brs(op, ms.(q.1), ms.(q.2), ms.(q.3), ms.(q.4))] for q in P]
          if #removeDuplicates(fs) > 1 then nbad := nbad + 1
testTrue("(nms = 35)@Boolean")
testTrue("(nbad = 0)@Boolean")

(x, y) : SymbolicTerm(Integer, [commutativity, associativity])
x := 'x; y := 'y
testTrue("not (x+x = 2*x)@Boolean")
testTrue("not ((1::SymbolicTerm(Integer, [commutativity, associativity]))+2 = 3)@Boolean")
testTrue("(unparse(form(y+(2+x))) = _"2+x+y_")@Boolean")

testcase "A_P with commutativity and associativity: all orders and groupings agree"
pl(u : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), v : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) == u + v
ml(u : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), v : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) == u * v
brs(op : (SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) -> SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), a : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), b : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), c : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), d : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) : List SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) == [op(op(op(a,b),c),d), op(op(a,op(b,c)),d), op(op(a,b),op(c,d)), op(a,op(op(b,c),d)), op(a,op(b,op(c,d)))]
perms(l : List Integer) : List List Integer == if empty? l then [empty()$List(Integer)] else concat [[cons(l.i, q) for q in perms(delete(l, i))] for i in 1..#l]
P := perms([1, 2, 3, 4])
lv : List SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) := [('x)::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), ('y)::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), 0::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), 1::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), 2::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])]
n := #lv
nbad : Integer := 0
nms : Integer := 0
for i in 1..n repeat
  for j in i..n repeat
    for k in j..n repeat
      for m in k..n repeat
        ms := [lv.i, lv.j, lv.k, lv.m]
        nms := nms + 1
        for op in [pl, ml] repeat
          fs := concat [[unparse(form t) for t in brs(op, ms.(q.1), ms.(q.2), ms.(q.3), ms.(q.4))] for q in P]
          if #removeDuplicates(fs) > 1 then nbad := nbad + 1
testTrue("(nms = 70)@Boolean")
testTrue("(nbad = 0)@Boolean")

(x, y) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])
x := 'x; y := 'y
testTrue("((1+x)+2 = x+3)@Boolean")
testTrue("(x*(0*y) = 0)@Boolean")
testTrue("(x+((-1)+1) = x)@Boolean")
testTrue("(2*(x*3) = 6*x)@Boolean")
testTrue("not (x+y = x*y)@Boolean")
testTrue("not (x+x = x)@Boolean")
testTrue("not (x*x = x^2)@Boolean")
testTrue("(unparse(form(y+(2+x))) = _"2+x+y_")@Boolean")

testcase "linear: P4, linear combinations (spec 3.4)"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])
x := 'x; y := 'y
testTrue("(x+x = 2*x)@Boolean")
testTrue("(2*x+3*x = 5*x)@Boolean")
testTrue("(x-x = 0)@Boolean")
testTrue("(2*(x+y) = 2*x+2*y)@Boolean")
testTrue("(-(x-y) = y-x)@Boolean")
testTrue("(x+y-x = y)@Boolean")
testTrue("((1/2)*x+(1/2)*x = x)@Boolean")
testTrue("(0*x = 0)@Boolean")
testTrue("(x*0+y = y)@Boolean")
testTrue("not (x*x = x^2)@Boolean")
testTrue("not (x*(y+1) = x*y+x)@Boolean")
testTrue("(unparse(form(y-2*x+1)) = _"(-(2*x))+y+1_")@Boolean")
testTrue("(unparse(form(3-x)) = _"(-x)+3_")@Boolean")
testTrue("(unparse(form(-x-1)) = _"(-x)-1_")@Boolean")
xftestTrue("(x+x = x)@Boolean")
-- random linear combinations, each written in many ways (property test)
atl : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) := [('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]), ('y)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]), ('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) * ('y)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]), sin(('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))]
rk(k : Integer, a : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) == (r := random(5)$Integer; if r = 0 then (k::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))*a else if r = 1 then ((k-1)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))*a + a else if r = 2 then ((k+1)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))*a - a else if r = 3 then a*(k::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])) else -(((-k)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))*a))
shuf(l : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])) : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) == if empty? l then l else (i := random(#l)$Integer + 1; cons(l.i, shuf(delete(l, i))))
rsum(l : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) == if #l = 1 then first l else (i : NonNegativeInteger := (random(#l - 1)$Integer + 1)::NonNegativeInteger; rsum(first(l, i)) + rsum(rest(l, i)))
build(v : List Integer, c : Integer) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) == rsum(shuf(concat([rk(v.i, atl.i) for i in 1..#atl | v.i ~= 0], [c::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])])))
ntr : Integer := 0
nbad : Integer := 0
ndiff : Integer := 0
for trial in 1..150 repeat
  v := [random(7)$Integer - 3 for i in 1..4]
  c := random(7)$Integer - 3
  e1 := build(v, c)
  e2 := build(v, c)
  ntr := ntr + 1
  if not (e1 = e2)@Boolean then nbad := nbad + 1
  w := [random(7)$Integer - 3 for i in 1..4]
  d := random(7)$Integer - 3
  if (v ~= w or c ~= d) and (e1 = build(w, d))@Boolean then ndiff := ndiff + 1
testTrue("(ntr = 150)@Boolean")
testTrue("(nbad = 0)@Boolean")
testTrue("(ndiff = 0)@Boolean")

testcase "powers and quotients: M4, M5, power products (spec 3.4)"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])
x := 'x; y := 'y
testTrue("(x*x = x^2)@Boolean")
testTrue("(x^2*x^3 = x^5)@Boolean")
testTrue("((x*y)^2 = x^2*y^2)@Boolean")
testTrue("((x^2)^3 = x^6)@Boolean")
testTrue("(x/x = 1)@Boolean")
testTrue("(x*y/x = y)@Boolean")
testTrue("(x^(-1)*x = 1)@Boolean")
testTrue("(x/y*y = x)@Boolean")
testTrue("((x/y)^(-1) = y/x)@Boolean")
testTrue("(1/(1/x) = x)@Boolean")
testTrue("(x/(2*y) = (1/2)*x/y)@Boolean")
testTrue("not (x+x = 2*x)@Boolean")
testTrue("(unparse(form(x^2*y)) = _"y*x^2_")@Boolean")
testTrue("(unparse(form(x/(y*x^2))) = _"1/(x*y)_")@Boolean")
xftestTrue("(x*x = x)@Boolean")
-- random power products, each written in many ways (property test)
atl : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) := [('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]), ('y)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]), sin(('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])), ('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) + 1]
rp(k : Integer, a : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) == (r := random(4)$Integer; if r = 0 then a^k else if r = 1 then a^(k-1)*a else if r = 2 then a^(k+1)/a else if k >= 0 then a^k else 1/a^(-k))
shuf(l : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])) : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) == if empty? l then l else (i := random(#l)$Integer + 1; cons(l.i, shuf(delete(l, i))))
rprod(l : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) == if #l = 1 then first l else (i : NonNegativeInteger := (random(#l - 1)$Integer + 1)::NonNegativeInteger; rprod(first(l, i)) * rprod(rest(l, i)))
cs : List Integer := [1, 2, -1, 3]
build(e : List Integer, c : Integer) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) == rprod(shuf(concat([rp(e.i, atl.i) for i in 1..#atl | e.i ~= 0], [c::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])])))
ntr : Integer := 0
nbad : Integer := 0
ndiff : Integer := 0
for trial in 1..150 repeat
  e := [random(5)$Integer - 2 for i in 1..4]
  c := cs.(random(4)$Integer + 1)
  e1 := build(e, c)
  e2 := build(e, c)
  ntr := ntr + 1
  if not (e1 = e2)@Boolean then nbad := nbad + 1
  f := [random(5)$Integer - 2 for i in 1..4]
  d := cs.(random(4)$Integer + 1)
  if (e ~= f or c ~= d) and (e1 = build(f, d))@Boolean then ndiff := ndiff + 1
testTrue("(ntr = 150)@Boolean")
testTrue("(nbad = 0)@Boolean")
testTrue("(ndiff = 0)@Boolean")

testcase "powers without quotients: M4, exponents at least 1"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers])
x := 'x; y := 'y
testTrue("(x*x = x^2)@Boolean")
testTrue("not (x/x = 1)@Boolean")
testTrue("not (x^(-1)*x = 1)@Boolean")
testTrue("(x^(-1)*x^(-1) = (x^(-1))^2)@Boolean")

testcase "linear with powers and quotients"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients])
x := 'x; y := 'y
testTrue("(2*x*y+3*y*x = 5*x*y)@Boolean")
testTrue("(x*x-x^2 = 0)@Boolean")
testTrue("(x/y+x/y = 2*x/y)@Boolean")
testTrue("((x+y)^2 = (y+x)*(x+y))@Boolean")
testTrue("not (x*(x+1) = x^2+x)@Boolean")
testTrue("not (2*x*(y+1) = 2*x*y+2*x)@Boolean")
testTrue("(2*(x+y)/2 = x+y)@Boolean")
testTrue("(((2*x*(y+1))::Expression(Integer)) = 2*('x::Expression(Integer))*('y::Expression(Integer)) + 2*('x::Expression(Integer)))@Boolean")

statistics()
