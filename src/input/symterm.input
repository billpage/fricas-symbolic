-- Tests for SymbolicTerm(R, A) (src/algebra/symterm.spad): design (II) of
-- the specification docs/spec/sexpr-spec.md, sections 3.2 and 3.4, with
-- axiom groups named in a list (decision 0009).  Equality is equality
-- modulo A: identity of normal forms.
--
-- Run with `make check` (also run by CI), or in a FriCAS session:
--   )compile src/algebra/gsexpr.spad
--   )compile src/algebra/symterm.spad
--   )read src/input/symterm.input
-- testsuite and testcase clear macros as well as variables, so each test
-- case writes the domain in full.

)set break resume
)expose UnittestCount UnittestAux Unittest

testsuite "SymbolicTerm"

testcase "no groups: P0/M0, nothing is rewritten (spec 3.4, G3)"
(x, y) : SymbolicTerm(Integer, [])
x := 'x; y := 'y
testTrue("not (x+0 = x)@Boolean")
testTrue("not (0*x = 0)@Boolean")
testTrue("not ((1::SymbolicTerm(Integer, []))+2 = 3)@Boolean")
testTrue("not (-(-x) = x)@Boolean")
testTrue("not (x+y = y+x)@Boolean")
testTrue("(x+y = x+y)@Boolean")
testTrue("(unparse(form(x+0)) = _"x+0_")@Boolean")
xftestTrue("(x+0 = x)@Boolean")

testcase "A_P groups: equality modulo identities, annihilation, involutions, numerals"
(x, y) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals])
x := 'x; y := 'y
testTrue("(x+0 = x)@Boolean")
testTrue("(1*x = x)@Boolean")
testTrue("(x^1 = x)@Boolean")
testTrue("(0*x = 0)@Boolean")
testTrue("(-(-x) = x)@Boolean")
testTrue("(1/(1/x) = x)@Boolean")
testTrue("((1::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals]))+2 = 3)@Boolean")
-- no commutativity or associativity: these stay different
testTrue("not (x+y = y+x)@Boolean")
testTrue("not ((x+1)+2 = x+3)@Boolean")
testTrue("not (x+(y+1) = (x+y)+1)@Boolean")
-- equality modulo A is not equality of value
testTrue("not ((x+1)^2 - (x^2+2*x+1) = 0)@Boolean")
testTrue("zero?((((x+1)^2 - (x^2+2*x+1))::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals]))::Expression(Integer))")
xftestTrue("(x+y = y+x)@Boolean")

testcase "A_P with associativity (spec 4.1.1)"
(w, x, y) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity])
w := 'w; x := 'x; y := 'y
testTrue("(x+(y+w) = (x+y)+w)@Boolean")
testTrue("(x*(y*w) = (x*y)*w)@Boolean")
testTrue("((x+1)+2 = x+3)@Boolean")
testTrue("(x+(1+2) = x+3)@Boolean")
testTrue("not ((1+x)+2 = x+3)@Boolean")
testTrue("not (x+y = y+x)@Boolean")

testcase "conversion to Expression keeps the value (spec 3.4, N3)"
(x, y) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity])
x := 'x; y := 'y
testTrue("(((x+y)+0)::Expression(Integer) = (y+x)::Expression(Integer))@Boolean")
testTrue("((x*(y*1))::Expression(Integer) = (y*x)::Expression(Integer))@Boolean")
testTrue("((sin(x)^2)::Expression(Integer) = sin(('x)::Expression(Integer))^2)@Boolean")

testcase "display reads back as the normal form (Disp)"
(x, y) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity])
x := 'x; y := 'y
rt(t : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity])) : Boolean == (parse(concat(lines(formatExpression(precondition(t::OutputForm)$OutputFormTools)$Format1D)))$InputForm = form t)@Boolean
testTrue("rt(x+(y+1)) and rt(x-(y-1)) and rt(x*(y/2)) and rt(sin(x+y)^2)")

testcase "display reads back as the normal form under linear, powers, quotients (Disp)"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients])
x := 'x; y := 'y
rt(t : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients])) : Boolean == (parse(concat(lines(formatExpression(precondition(t::OutputForm)$OutputFormTools)$Format1D)))$InputForm = form t)@Boolean
testTrue("rt(y-2*x+1) and rt(3-x) and rt(-x-1) and rt(x/(2*y)) and rt(x/(y*x^2)) and rt(2*x*y+3*y*x) and rt((1/2)*x+y) and rt(x^(-1)) and rt(-(x/y)) and rt(sin(x-y)^(-2)*(x+1)) and rt(x-(1/3)*y^2)")

testcase "ring: polynomials over the atoms (spec 3.4, rung Ring)"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, ring])
x := 'x; y := 'y
testTrue("(x*(x+1) = x^2+x)@Boolean")
testTrue("((x+y)^2 = x^2+2*x*y+y^2)@Boolean")
testTrue("((x+1)*(x-1) = x^2-1)@Boolean")
testTrue("((x+y)^2-(x-y)^2 = 4*x*y)@Boolean")
testTrue("(x/2 = (1/2)*x)@Boolean")
testTrue("(sin(x)*(sin(x)+1) = sin(x)^2+sin(x))@Boolean")
testTrue("not (sqrt(2::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, ring]))^2 = 2)@Boolean")
testTrue("not (x/y*y = x)@Boolean")
testTrue("not (x^(-1)*x = 1)@Boolean")
testTrue("(unparse(form(x*(x+1))) = _"x+x^2_")@Boolean")
testTrue("(unparse(form((x+1)*(x-1))) = _"x^2-1_")@Boolean")
xftestTrue("(x*(x+1) = x)@Boolean")
-- random trees, built in Ring and in Polynomial(Integer) with the same choices:
-- equal normal forms exactly when the model says equal (N1, N2)
PR ==> Record(t : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, ring]), p : Polynomial(Integer))
gen(d : Integer) : PR == (d <= 0 => (r := random(6)$Integer; r = 0 => [('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, ring]), ('x)::Polynomial(Integer)]$PR; r = 1 => [('y)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, ring]), ('y)::Polynomial(Integer)]$PR; r = 2 => [sin(('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, ring])), ('s)::Polynomial(Integer)]$PR; r = 3 => [2::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, ring]), 2::Polynomial(Integer)]$PR; r = 4 => [(-1)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, ring]), (-1)::Polynomial(Integer)]$PR; [0::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, ring]), 0::Polynomial(Integer)]$PR); a := gen(d - 1); b := gen(d - 1); r := random(5)$Integer; r = 0 => [a.t + b.t, a.p + b.p]$PR; r = 1 => [a.t - b.t, a.p - b.p]$PR; r = 2 => [a.t * b.t, a.p * b.p]$PR; r = 3 => [a.t ^ 2, a.p ^ 2]$PR; [- a.t, - a.p]$PR)
ntr : Integer := 0
nbad : Integer := 0
nvar : Integer := 0
for trial in 1..200 repeat
  g1 := gen(3)
  g2 := gen(2)
  ntr := ntr + 1
  if not ((g1.t = g2.t)@Boolean = (g1.p = g2.p)@Boolean) then nbad := nbad + 1
  h := gen(2)
  for w in [h.t + g1.t - h.t, (h.t - h.t + 1) * g1.t, -(-g1.t), g1.t * h.t - h.t * g1.t + g1.t] repeat
    nvar := nvar + 1
    if not (w = g1.t)@Boolean then nbad := nbad + 1
testTrue("(ntr = 200)@Boolean")
testTrue("(nvar = 800)@Boolean")
testTrue("(nbad = 0)@Boolean")

testcase "field: reduced fractions over the atoms (spec 3.4, rung Field)"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field])
x := 'x; y := 'y
testTrue("((x^2-1)/(x-1) = x+1)@Boolean")
testTrue("(x/y+y/x = (x^2+y^2)/(x*y))@Boolean")
testTrue("(1/(1/x+1/y) = x*y/(x+y))@Boolean")
testTrue("(x/(x+1)+1/(x+1) = 1)@Boolean")
testTrue("((2*x+2)/(4*x-4) = (x+1)/(2*x-2))@Boolean")
testTrue("(sin(x)/sin(x) = 1)@Boolean")
testTrue("not (sqrt(2::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]))^2 = 2)@Boolean")
testTrue("(unparse(form(x/y+y/x)) = _"(x^2+y^2)/(x*y)_")@Boolean")
testTrue("(unparse(form(x/(2*y))) = _"x/(2*y)_")@Boolean")
testTrue("(unparse(form((2*x+2)/(4*x-4))) = _"(x+1)/(2*x-2)_")@Boolean")
testTrue("(unparse(form((x/2+1)/(y/3))) = _"(3*x+6)/(2*y)_")@Boolean")
testTrue("(unparse(form((1-x)/(y-x))) = _"(x-1)/(x-y)_")@Boolean")
xftestTrue("(x/x = x)@Boolean")
-- random trees, built in Field and in Fraction(Polynomial(Integer)) with the same choices:
-- equal normal forms exactly when the model says equal (N1, N2)
PR ==> Record(t : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), p : Fraction(Polynomial(Integer)))
gen(d : Integer) : PR == (d <= 0 => (r := random(6)$Integer; r = 0 => [('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), ('x)::Fraction(Polynomial(Integer))]$PR; r = 1 => [('y)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), ('y)::Fraction(Polynomial(Integer))]$PR; r = 2 => [sin(('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field])), ('s)::Fraction(Polynomial(Integer))]$PR; r = 3 => [2::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), 2::Fraction(Polynomial(Integer))]$PR; r = 4 => [(-1)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), (-1)::Fraction(Polynomial(Integer))]$PR; [0::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), 0::Fraction(Polynomial(Integer))]$PR); a := gen(d - 1); b := gen(d - 1); r := random(6)$Integer; r = 0 => [a.t + b.t, a.p + b.p]$PR; r = 1 => [a.t - b.t, a.p - b.p]$PR; r = 2 => [a.t * b.t, a.p * b.p]$PR; r = 3 => [a.t ^ 2, a.p ^ 2]$PR; r = 4 and not zero?(b.p) => [a.t / b.t, a.p / b.p]$PR; [- a.t, - a.p]$PR)
ntr : Integer := 0
nbad : Integer := 0
nvar : Integer := 0
for trial in 1..200 repeat
  g1 := gen(3)
  g2 := gen(2)
  ntr := ntr + 1
  if not ((g1.t = g2.t)@Boolean = (g1.p = g2.p)@Boolean) then nbad := nbad + 1
  h := gen(2)
  k := h.t ^ 2 + 1
  for w in [h.t + g1.t - h.t, (h.t - h.t + 1) * g1.t, -(-g1.t), g1.t * k / k, (g1.t * (k + h.t)) / (k + h.t)] repeat
    nvar := nvar + 1
    if not (w = g1.t)@Boolean then nbad := nbad + 1
testTrue("(ntr = 200)@Boolean")
testTrue("(nvar = 1000)@Boolean")
testTrue("(nbad = 0)@Boolean")

testcase "display reads back as the normal form under ring and field (Disp)"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field])
x := 'x; y := 'y
rt(t : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field])) : Boolean == (parse(concat(lines(formatExpression(precondition(t::OutputForm)$OutputFormTools)$Format1D)))$InputForm = form t)@Boolean
testTrue("rt(x/y+y/x) and rt((2*x+2)/(4*x-4)) and rt(1/(1/x+1/y)) and rt((x-y)^3) and rt(-(x+1)/(y-x)) and rt(sin(x-1)/(x^2-2*x))")

-- Ported from sexpr2.input (Kurt Pagani's 2017 suite for the 2017
-- Symbolic(R, A), retired in plan step 6).  The 2017 axiom set of the old
-- SymbolicExpression maps to groups: Identities, Annihilation, Inverse,
-- Associative, Commutative, Doubles and Cancels (linear), Squares (powers),
-- Divides (quotients); Symbolic folded numerals without an axiom
-- (numerals).  What was not ported, and why: docs/notes/2026-11-26-retiring-symbolic.md.
testcase "ported from sexpr2 ex1: no groups keep 1+1+1, the value is 3 (G3)"
s : SymbolicTerm(Integer, []) := 1 + 1 + 1
eins : SymbolicTerm(Integer, []) := 1
testTrue("(s = eins + eins + eins)@Boolean")
testTrue("not (s = 3)@Boolean")
testTrue("((s::Expression(Integer)) = 3)@Boolean")
testTrue("(unparse(form s) = _"1+1+1_")@Boolean")

testcase "ported from sexpr2 ex2, ex3: the laws of the 2017 axiom set"
(x, y, z) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity, linear, powers, quotients])
x := 'x; y := 'y; z := 'z
testTrue("(x+x = 2*x)@Boolean")
testTrue("(x-x = 0)@Boolean")
testTrue("(x+y = y+x)@Boolean")
testTrue("(x+(y+z) = (x+y)+z)@Boolean")
testTrue("(x*x = x^2)@Boolean")
testTrue("(x/x = 1)@Boolean")
testTrue("(x*(1/x) = 1)@Boolean")
testTrue("(x*y = y*x)@Boolean")
testTrue("(x*(y*z) = (x*y)*z)@Boolean")
-- no distributivity in the 2017 set: compare values, as sexpr2 did
testTrue("not (x*(y+z) = x*y + x*z)@Boolean")
testTrue("(((x*(y+z))::Expression(Integer)) = ((z*x + y*x)::Expression(Integer)))@Boolean")
testTrue("((((x+y)^2)::Expression(Integer)) = ((x^2 + 2*x*y + y^2)::Expression(Integer)))@Boolean")
s10 : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity, linear, powers, quotients]) := 0
for n in 1..10 repeat s10 := s10 + n::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity, linear, powers, quotients])
testTrue("(s10 = 55)@Boolean")
xftestTrue("(x+y = x*y)@Boolean")
xftestTrue("(x*x = 2*x)@Boolean")

testcase "ported from sexpr2: Doubles, coefficient on either side"
(x, y) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity, linear, powers, quotients])
x := 'x; y := 'y
testTrue("(unparse(form(2*x+3*x)) = _"5*x_")@Boolean")
testTrue("(unparse(form(x*2+x*3)) = _"5*x_")@Boolean")
testTrue("(unparse(form(x+(x+y))) = _"2*x+y_")@Boolean")
testTrue("(unparse(form((y+x)+x)) = _"2*x+y_")@Boolean")
xftestTrue("(unparse(form(2*x+3*x)) = _"3*x+2*x_")@Boolean")

testcase "ported from sexpr2: G3, no groups keep the written form (spec 4.2)"
(x, y) : SymbolicTerm(Integer, [])
x := 'x; y := 'y
p2 : PositiveInteger := 2
p3 : PositiveInteger := 3
n3 : Integer := 3
f(t : SymbolicTerm(Integer, [])) : String == unparse(form t)
testTrue("(f(0*x) = _"0*x_")@Boolean")
testTrue("(f(x*0) = _"x*0_")@Boolean")
testTrue("(f(0-y) = _"0-y_")@Boolean")
testTrue("(f(1/(x/y)) = _"1/(x/y)_")@Boolean")
testTrue("(f(-(x-y)) = _"-(x-y)_")@Boolean")
testTrue("(f(-(x+y)) = _"-(x+y)_")@Boolean")
testTrue("(f(p2*x) = _"2*x_")@Boolean")
testTrue("(f(p2*x + p3*x) = _"2*x+3*x_")@Boolean")
testTrue("(f(x^p3) = _"x^3_")@Boolean")
testTrue("(f(x^n3) = _"x^3_")@Boolean")
testTrue("(f(x^(-2)) = _"x^(-2)_")@Boolean")
xftestTrue("(f(p2*x) = _"x+x_")@Boolean")
-- the same inputs are rewritten under the 2017 set
(u, v) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity, linear, powers, quotients])
u := 'x; v := 'y
g(t : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity, linear, powers, quotients])) : String == unparse(form t)
testTrue("(g(0*u) = _"0_")@Boolean")
testTrue("(g(0-v) = _"-(y)_")@Boolean")

testcase "floats as numerals in SymbolicTerm(Float, A) (decision 0010)"
(y, z) : SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field])
y := 'y; z := 'z
st(t : SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field])) : String == concat lines(formatExpression(precondition(t::OutputForm)$OutputFormTools)$Format1D)
rt(t : SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field])) : Boolean == (parse(st t)$InputForm = form t)@Boolean
-- exact rational arithmetic on the decimals, rounded only when needed
testTrue("(y + 0.1 + 0.2 = y + 0.3)@Boolean")
testTrue("((y^2 - 0.01)/(y - 0.1) = y + 0.1)@Boolean")
testTrue("(1.5*y + 2*y = 3.5*y)@Boolean")
-- every numeral of a floating-point domain is a float numeral
testTrue("(st((y + 1.5)*(z + 2)) = _"2.0*y+1.5*z+y*z+3.0_")@Boolean")
testTrue("(st(2*y + 1.5*z) = _"2.0*y+1.5*z_")@Boolean")
testTrue("(st(y/3.0) = _"0.33333333333333333333*y_")@Boolean")
-- 1/3 is rounded where it is made; the sum of the two decimals is exact
testTrue("(st(y/3 + y/3) = _"0.66666666666666666666*y_")@Boolean")
-- exponents stay exact integers
testTrue("(st(y^2*y^3/y) = _"y^4_")@Boolean")
-- 1.0 and 0.0 are the reals 1 and 0
testTrue("(1.0*y = y)@Boolean")
testTrue("(y + 0.0 = y)@Boolean")
-- 2 and 2.0 are the same numeral
testTrue("(2*y = 2.0*y)@Boolean")
-- the rounding caveat: 1/3.0 is 0.33333333333333333333
testTrue("not (y + 1/3.0 + 1/3.0 + 1/3.0 = y + 1.0)@Boolean")
xftestTrue("(y + 1/3.0 + 1/3.0 + 1/3.0 = y + 1.0)@Boolean")
ts : List SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]) := [(y + 1.5)*(z + 2), (y^2 - 0.01)/(y - 0.1), y/3.0, (2.5*y - 1)/(0.5*z), -(1.25*y), y^2*1.0e30, y*1.0e-8]
testTrue("(#ts = 7)@Boolean")
testTrue("every?(rt, ts)")
-- random linear combinations with one-decimal coefficients, each written
-- in many ways: no rounding occurs, so all give one normal form (N2)
atl : List SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear]) := [('y)::SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear]), ('z)::SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear]), sin(('y)::SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear]))]
rk(k : Integer, a : SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear])) : SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear]) == (r := random(4)$Integer; g : SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear]) := ((k::Float)/10)::SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear]); r = 0 => g*a; r = 1 => a*g; r = 2 => (g + 1)*a - a; (g - 1)*a + a)
shuf(l : List SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear])) : List SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear]) == if empty? l then l else (i := random(#l)$Integer + 1; cons(l.i, shuf(delete(l, i))))
rsum(l : List SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear])) : SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear]) == if #l = 1 then first l else (i : NonNegativeInteger := (random(#l - 1)$Integer + 1)::NonNegativeInteger; rsum(first(l, i)) + rsum(rest(l, i)))
build(v : List Integer) : SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear]) == rsum(shuf([rk(v.i, atl.i) for i in 1..#atl | v.i ~= 0]))
ntr : Integer := 0
nbad : Integer := 0
for trial in 1..100 repeat
  v := [random(41)$Integer - 20 for i in 1..3]
  if every?((k : Integer) : Boolean +-> k ~= 0, v) then
    ntr := ntr + 1
    if not (build(v) = build(v))@Boolean then nbad := nbad + 1
testTrue("(ntr > 50)@Boolean")
testTrue("(nbad = 0)@Boolean")

testcase "term order on numerals: exact, then float, by value (spec 3.5, decision 0010)"
lt(a : String, b : String) : Boolean == smaller?(parse(a)$InputForm, parse(b)$InputForm)$SymbolicTermOrder
testTrue("lt(_"2_", _"1.5_")")
testTrue("lt(_"-1/2_", _"2_")")
testTrue("lt(_"-0.5_", _"1.5_")")
testTrue("lt(_"1.5_", _"2.5e3_")")
testTrue("lt(_"1.5_", _"u_")")
testTrue("lt(_"2.5e-3_", _"0.5_")")
testTrue("not lt(_"1.5_", _"1.5_")")
-- equal values: by shape, the atom before the negation
testTrue("smaller?(convert(-3)@InputForm, parse(_"-3_")$InputForm)$SymbolicTermOrder")
testTrue("not smaller?(parse(_"-3_")$InputForm, convert(-3)@InputForm)$SymbolicTermOrder")
xftestTrue("lt(_"1.5_", _"2_")")

testcase "bridge: eval is the homomorphism extending phi (decision 0011, spec 3.2)"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field])
x := 'x; y := 'y
toE(t : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field])) : Expression(Integer) == eval(t, (s : Symbol) : Expression(Integer) +-> s::Expression(Integer))$SymbolicTermFunctions2(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field], Expression(Integer))
psiF(s : Symbol, l : List Fraction(Polynomial(Integer))) : Fraction(Polynomial(Integer)) == (s = 'sin => ('s)::Fraction(Polynomial(Integer)); error "unexpected operator")
toF(t : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field])) : Fraction(Polynomial(Integer)) == eval(t, (s : Symbol) : Fraction(Polynomial(Integer)) +-> s::Fraction(Polynomial(Integer)), psiF)$SymbolicTermFunctions2(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field], Fraction(Polynomial(Integer)))
-- the value map is the instance D = Expression R
testTrue("(toE((x^2 - 1)/(x - 1) + sin(y)/2) = ((x^2 - 1)/(x - 1) + sin(y)/2)::Expression(Integer))@Boolean")
testTrue("(toF((x + y)^2/(x*y)) = (('x::Fraction(Polynomial(Integer))) + ('y::Fraction(Polynomial(Integer))))^2/(('x::Fraction(Polynomial(Integer)))*('y::Fraction(Polynomial(Integer)))))@Boolean")
-- random terms built in parallel in SymbolicTerm and in the model: eval of
-- the normal form agrees with the model (eval respects =_A); the value map
-- agrees with eval into Expression; and the read-back gives the term back
PR ==> Record(t : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), p : Fraction(Polynomial(Integer)))
gen(d : Integer) : PR == (d <= 0 => (r := random(6)$Integer; r = 0 => [('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), ('x)::Fraction(Polynomial(Integer))]$PR; r = 1 => [('y)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), ('y)::Fraction(Polynomial(Integer))]$PR; r = 2 => [sin(('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field])), ('s)::Fraction(Polynomial(Integer))]$PR; r = 3 => [2::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), 2::Fraction(Polynomial(Integer))]$PR; r = 4 => [(1/2)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), (1/2)::Fraction(Polynomial(Integer))]$PR; [(-1)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), (-1)::Fraction(Polynomial(Integer))]$PR); a := gen(d - 1); b := gen(d - 1); r := random(6)$Integer; r = 0 => [a.t + b.t, a.p + b.p]$PR; r = 1 => [a.t - b.t, a.p - b.p]$PR; r = 2 => [a.t * b.t, a.p * b.p]$PR; r = 3 => [a.t ^ 2, a.p ^ 2]$PR; r = 4 and not zero?(b.p) => [a.t / b.t, a.p / b.p]$PR; [- a.t, - a.p]$PR)
ntr : Integer := 0
nbad : Integer := 0
for trial in 1..150 repeat
  g := gen(3)
  ntr := ntr + 1
  if not (toF(g.t) = g.p)@Boolean then nbad := nbad + 1
  if not (toE(g.t) = g.t::Expression(Integer))@Boolean then nbad := nbad + 1
  if not (convert(form g.t)@SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]) = g.t)@Boolean then nbad := nbad + 1
testTrue("(ntr = 150)@Boolean")
testTrue("(nbad = 0)@Boolean")
-- numerical evaluation: D = Float
testTrue("(abs(eval((x^2 - 1)/(x - 1) + sin(y)/2, (s : Symbol) : Float +-> (s = 'x => 2.0; 0.5))$SymbolicTermFunctions2(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field], Float) - (3 + sin(0.5)/2)) < 10.0^(-15))@Boolean")
xftestTrue("(toF(x + y) = ('x::Fraction(Polynomial(Integer))))@Boolean")

testcase "bridge: adding and dropping axioms by read-back (decision 0011)"
(a, b) : SymbolicTerm(Integer, [])
a := 'x; b := 'y
w := (a + a) + 0*b
testTrue("(unparse(form w) = _"x+x+0*y_")@Boolean")
testTrue("(unparse(form(convert(form w)@SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))) = _"2*x_")@Boolean")
-- dropping axioms reads the normal form back as written
testTrue("(unparse(form(convert(form(convert(form w)@SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])))@SymbolicTerm(Integer, []))) = _"2*x_")@Boolean")
testTrue("(convert(form w)@SymbolicTerm(Integer, []) = w)@Boolean")
xftestTrue("(unparse(form(convert(form w)@SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))) = _"x+x+0*y_")@Boolean")

testcase "bridge: without commutativity, into matrices (decision 0011)"
(p, q) : SymbolicTerm(Integer, [associativity, identities])
p := 'p; q := 'q
mp : SquareMatrix(2, Fraction(Integer)) := matrix [[1, 2], [3, 4]]
mq : SquareMatrix(2, Fraction(Integer)) := matrix [[0, 1], [1, 0]]
ev(v : SymbolicTerm(Integer, [associativity, identities])) : SquareMatrix(2, Fraction(Integer)) == eval(v, (s : Symbol) : SquareMatrix(2, Fraction(Integer)) +-> (s = 'p => mp; mq))$SymbolicTermFunctions2(Integer, [associativity, identities], SquareMatrix(2, Fraction(Integer)))
testTrue("(ev(p*q*p) = mp*mq*mp)@Boolean")
testTrue("not (ev(p*q) = ev(q*p))@Boolean")
testTrue("(ev((p + q)^2) = (mp + mq)^2)@Boolean")
xftestTrue("(ev(p*q) = ev(q*p))@Boolean")

testcase "bridge: refused targets (decision 0011)"
-- commutativity, linear, powers, ring need a commutative ring D
testLibraryError("eval(('p)::SymbolicTerm(Integer, [commutativity]), (s : Symbol) : SquareMatrix(2, Fraction(Integer)) +-> 1)$SymbolicTermFunctions2(Integer, [commutativity], SquareMatrix(2, Fraction(Integer)))")
-- quotients and field need a field D
testLibraryError("eval(('p)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field]), (s : Symbol) : Polynomial(Fraction(Integer)) +-> 1)$SymbolicTermFunctions2(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients, ring, field], Polynomial(Fraction(Integer)))")
-- numerals need Fraction Integer in D
testLibraryError("eval(('p)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]), (s : Symbol) : Polynomial(Integer) +-> 1)$SymbolicTermFunctions2(Integer, [commutativity, associativity, identities, numerals, linear], Polynomial(Integer))")
-- an operator D cannot interpret
testLibraryError("eval(sin(('p)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])), (s : Symbol) : Polynomial(Fraction(Integer)) +-> 1)$SymbolicTermFunctions2(Integer, [commutativity, associativity, identities, numerals, linear], Polynomial(Fraction(Integer)))")
-- accepted: a commutative D with Fraction Integer
testTrue("(eval(('p)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) + 1, (s : Symbol) : Polynomial(Fraction(Integer)) +-> 2)$SymbolicTermFunctions2(Integer, [commutativity, associativity, identities, numerals, linear], Polynomial(Fraction(Integer))) = 3)@Boolean")

testcase "bridge: float numerals (decisions 0010, 0011)"
y : SymbolicTerm(Float, [commutativity, associativity, identities, numerals, linear]) := 'y
testTrue("(eval(1.5*y + 0.25, (s : Symbol) : Float +-> 2.0)$SymbolicTermFunctions2(Float, [commutativity, associativity, identities, numerals, linear], Float) = 3.25)@Boolean")
testTrue("(eval(1.5*y + 0.25, (s : Symbol) : Expression(Float) +-> s::Expression(Float))$SymbolicTermFunctions2(Float, [commutativity, associativity, identities, numerals, linear], Expression(Float)) = (1.5*y + 0.25)::Expression(Float))@Boolean")

testcase "admissibility (spec 3.4, decision 0009)"
-- unknown group; ring with quotients but without field; both constructors
testLibraryError("('x)::SymbolicTerm(Integer, [identity])")
testLibraryError("('x)::SymbolicTerm(Integer, [ring, quotients, linear, powers, commutativity, associativity, identities, numerals])")
testLibraryError("('x)::GeneralSymbolicExpression(Integer, [identity])")
testLibraryError("('x)::GeneralSymbolicExpression(Integer, [ring, quotients, linear, powers, commutativity, associativity, identities, numerals])")
-- requirements, checked with every group taken as implemented
testLibraryError("checkGroups(_"test_", [numerals], [identities])$SymbolicAxiomGroups")
testTrue("(checkGroups(_"test_", [ring, field, quotients, linear, powers, commutativity, associativity, identities, numerals], groups())$SymbolicAxiomGroups; true)")
testLibraryError("checkGroups(_"test_", [linear], groups())$SymbolicAxiomGroups")
testLibraryError("checkGroups(_"test_", [quotients, commutativity, associativity, identities, numerals], groups())$SymbolicAxiomGroups")
testTrue("(checkGroups(_"test_", [linear, commutativity, associativity, identities, numerals], groups())$SymbolicAxiomGroups; true)")
testTrue("(checkGroups(_"test_", [field, ring, quotients, powers, linear, commutativity, associativity, identities, numerals], groups())$SymbolicAxiomGroups; true)")
-- admissible lists are accepted
testTrue("(unparse(form(('x)::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity]))) = _"x_")@Boolean")
testTrue("(unparse(form(('x)::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals]))) = _"x_")@Boolean")

testcase "commutativity alone: P1/M1, operands of each node sorted (spec 3.4)"
(x, y, z) : SymbolicTerm(Integer, [commutativity])
x := 'x; y := 'y; z := 'z
testTrue("(x+y = y+x)@Boolean")
testTrue("(x*y = y*x)@Boolean")
testTrue("((x+y)+z = z+(y+x))@Boolean")
testTrue("not ((x+y)+z = x+(y+z))@Boolean")
testTrue("not (x+0 = x)@Boolean")
testTrue("not ((1::SymbolicTerm(Integer, [commutativity]))+2 = 3)@Boolean")
testTrue("(unparse(form(y+x)) = _"x+y_")@Boolean")
xftestTrue("(unparse(form(y+x)) = _"y+x_")@Boolean")
-- swapping the operands at any node of a three-leaf tree gives one form
lc : List SymbolicTerm(Integer, [commutativity]) := [('x)::SymbolicTerm(Integer, [commutativity]), ('y)::SymbolicTerm(Integer, [commutativity]), ('z)::SymbolicTerm(Integer, [commutativity]), 1::SymbolicTerm(Integer, [commutativity])]
ncomb : Integer := 0
nsw : Integer := 0
for a in lc repeat
  for b in lc repeat
    for c in lc repeat
      ncomb := ncomb + 1
      g1 := [unparse(form t) for t in [(a+b)+c, (b+a)+c, c+(a+b), c+(b+a), (a*b)*c, (b*a)*c, c*(a*b), c*(b*a)]]
      g2 := [unparse(form t) for t in [a+(b+c), a+(c+b), (b+c)+a, (c+b)+a, a*(b*c), a*(c*b), (b*c)*a, (c*b)*a]]
      if #removeDuplicates(first(g1, 4)) > 1 or #removeDuplicates(rest(g1, 4)) > 1 then nsw := nsw + 1
      if #removeDuplicates(first(g2, 4)) > 1 or #removeDuplicates(rest(g2, 4)) > 1 then nsw := nsw + 1
testTrue("(ncomb = 64)@Boolean")
testTrue("(nsw = 0)@Boolean")

testcase "commutativity with associativity: P3/M3, all orders and groupings agree (spec 3.4)"
pl(u : SymbolicTerm(Integer, [commutativity, associativity]), v : SymbolicTerm(Integer, [commutativity, associativity])) : SymbolicTerm(Integer, [commutativity, associativity]) == u + v
ml(u : SymbolicTerm(Integer, [commutativity, associativity]), v : SymbolicTerm(Integer, [commutativity, associativity])) : SymbolicTerm(Integer, [commutativity, associativity]) == u * v
brs(op : (SymbolicTerm(Integer, [commutativity, associativity]), SymbolicTerm(Integer, [commutativity, associativity])) -> SymbolicTerm(Integer, [commutativity, associativity]), a : SymbolicTerm(Integer, [commutativity, associativity]), b : SymbolicTerm(Integer, [commutativity, associativity]), c : SymbolicTerm(Integer, [commutativity, associativity]), d : SymbolicTerm(Integer, [commutativity, associativity])) : List SymbolicTerm(Integer, [commutativity, associativity]) == [op(op(op(a,b),c),d), op(op(a,op(b,c)),d), op(op(a,b),op(c,d)), op(a,op(op(b,c),d)), op(a,op(b,op(c,d)))]
perms(l : List Integer) : List List Integer == if empty? l then [empty()$List(Integer)] else concat [[cons(l.i, q) for q in perms(delete(l, i))] for i in 1..#l]
P := perms([1, 2, 3, 4])
lv : List SymbolicTerm(Integer, [commutativity, associativity]) := [('x)::SymbolicTerm(Integer, [commutativity, associativity]), ('y)::SymbolicTerm(Integer, [commutativity, associativity]), 1::SymbolicTerm(Integer, [commutativity, associativity]), 2::SymbolicTerm(Integer, [commutativity, associativity])]
n := #lv
nbad : Integer := 0
nms : Integer := 0
for i in 1..n repeat
  for j in i..n repeat
    for k in j..n repeat
      for m in k..n repeat
        ms := [lv.i, lv.j, lv.k, lv.m]
        nms := nms + 1
        for op in [pl, ml] repeat
          fs := concat [[unparse(form t) for t in brs(op, ms.(q.1), ms.(q.2), ms.(q.3), ms.(q.4))] for q in P]
          if #removeDuplicates(fs) > 1 then nbad := nbad + 1
testTrue("(nms = 35)@Boolean")
testTrue("(nbad = 0)@Boolean")

(x, y) : SymbolicTerm(Integer, [commutativity, associativity])
x := 'x; y := 'y
testTrue("not (x+x = 2*x)@Boolean")
testTrue("not ((1::SymbolicTerm(Integer, [commutativity, associativity]))+2 = 3)@Boolean")
testTrue("(unparse(form(y+(2+x))) = _"2+x+y_")@Boolean")

testcase "A_P with commutativity and associativity: all orders and groupings agree"
pl(u : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), v : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) == u + v
ml(u : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), v : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) == u * v
brs(op : (SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) -> SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), a : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), b : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), c : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), d : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) : List SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) == [op(op(op(a,b),c),d), op(op(a,op(b,c)),d), op(op(a,b),op(c,d)), op(a,op(op(b,c),d)), op(a,op(b,op(c,d)))]
perms(l : List Integer) : List List Integer == if empty? l then [empty()$List(Integer)] else concat [[cons(l.i, q) for q in perms(delete(l, i))] for i in 1..#l]
P := perms([1, 2, 3, 4])
lv : List SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) := [('x)::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), ('y)::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), 0::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), 1::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), 2::SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])]
n := #lv
nbad : Integer := 0
nms : Integer := 0
for i in 1..n repeat
  for j in i..n repeat
    for k in j..n repeat
      for m in k..n repeat
        ms := [lv.i, lv.j, lv.k, lv.m]
        nms := nms + 1
        for op in [pl, ml] repeat
          fs := concat [[unparse(form t) for t in brs(op, ms.(q.1), ms.(q.2), ms.(q.3), ms.(q.4))] for q in P]
          if #removeDuplicates(fs) > 1 then nbad := nbad + 1
testTrue("(nms = 70)@Boolean")
testTrue("(nbad = 0)@Boolean")

(x, y) : SymbolicTerm(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])
x := 'x; y := 'y
testTrue("((1+x)+2 = x+3)@Boolean")
testTrue("(x*(0*y) = 0)@Boolean")
testTrue("(x+((-1)+1) = x)@Boolean")
testTrue("(2*(x*3) = 6*x)@Boolean")
testTrue("not (x+y = x*y)@Boolean")
testTrue("not (x+x = x)@Boolean")
testTrue("not (x*x = x^2)@Boolean")
testTrue("(unparse(form(y+(2+x))) = _"2+x+y_")@Boolean")

testcase "linear: P4, linear combinations (spec 3.4)"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])
x := 'x; y := 'y
testTrue("(x+x = 2*x)@Boolean")
testTrue("(2*x+3*x = 5*x)@Boolean")
testTrue("(x-x = 0)@Boolean")
testTrue("(2*(x+y) = 2*x+2*y)@Boolean")
testTrue("(-(x-y) = y-x)@Boolean")
testTrue("(x+y-x = y)@Boolean")
testTrue("((1/2)*x+(1/2)*x = x)@Boolean")
testTrue("(0*x = 0)@Boolean")
testTrue("(x*0+y = y)@Boolean")
testTrue("not (x*x = x^2)@Boolean")
testTrue("not (x*(y+1) = x*y+x)@Boolean")
testTrue("(unparse(form(y-2*x+1)) = _"(-(2*x))+y+1_")@Boolean")
testTrue("(unparse(form(3-x)) = _"(-x)+3_")@Boolean")
testTrue("(unparse(form(-x-1)) = _"(-x)-1_")@Boolean")
xftestTrue("(x+x = x)@Boolean")
-- random linear combinations, each written in many ways (property test)
atl : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) := [('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]), ('y)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]), ('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) * ('y)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]), sin(('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))]
rk(k : Integer, a : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) == (r := random(5)$Integer; if r = 0 then (k::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))*a else if r = 1 then ((k-1)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))*a + a else if r = 2 then ((k+1)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))*a - a else if r = 3 then a*(k::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])) else -(((-k)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]))*a))
shuf(l : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])) : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) == if empty? l then l else (i := random(#l)$Integer + 1; cons(l.i, shuf(delete(l, i))))
rsum(l : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) == if #l = 1 then first l else (i : NonNegativeInteger := (random(#l - 1)$Integer + 1)::NonNegativeInteger; rsum(first(l, i)) + rsum(rest(l, i)))
build(v : List Integer, c : Integer) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear]) == rsum(shuf(concat([rk(v.i, atl.i) for i in 1..#atl | v.i ~= 0], [c::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear])])))
ntr : Integer := 0
nbad : Integer := 0
ndiff : Integer := 0
for trial in 1..150 repeat
  v := [random(7)$Integer - 3 for i in 1..4]
  c := random(7)$Integer - 3
  e1 := build(v, c)
  e2 := build(v, c)
  ntr := ntr + 1
  if not (e1 = e2)@Boolean then nbad := nbad + 1
  w := [random(7)$Integer - 3 for i in 1..4]
  d := random(7)$Integer - 3
  if (v ~= w or c ~= d) and (e1 = build(w, d))@Boolean then ndiff := ndiff + 1
testTrue("(ntr = 150)@Boolean")
testTrue("(nbad = 0)@Boolean")
testTrue("(ndiff = 0)@Boolean")

testcase "powers and quotients: M4, M5, power products (spec 3.4)"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])
x := 'x; y := 'y
testTrue("(x*x = x^2)@Boolean")
testTrue("(x^2*x^3 = x^5)@Boolean")
testTrue("((x*y)^2 = x^2*y^2)@Boolean")
testTrue("((x^2)^3 = x^6)@Boolean")
testTrue("(x/x = 1)@Boolean")
testTrue("(x*y/x = y)@Boolean")
testTrue("(x^(-1)*x = 1)@Boolean")
testTrue("(x/y*y = x)@Boolean")
testTrue("((x/y)^(-1) = y/x)@Boolean")
testTrue("(1/(1/x) = x)@Boolean")
testTrue("(x/(2*y) = (1/2)*x/y)@Boolean")
testTrue("not (x+x = 2*x)@Boolean")
testTrue("(unparse(form(x^2*y)) = _"y*x^2_")@Boolean")
testTrue("(unparse(form(x/(y*x^2))) = _"1/(x*y)_")@Boolean")
xftestTrue("(x*x = x)@Boolean")
-- random power products, each written in many ways (property test)
atl : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) := [('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]), ('y)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]), sin(('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])), ('x)::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) + 1]
rp(k : Integer, a : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) == (r := random(4)$Integer; if r = 0 then a^k else if r = 1 then a^(k-1)*a else if r = 2 then a^(k+1)/a else if k >= 0 then a^k else 1/a^(-k))
shuf(l : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])) : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) == if empty? l then l else (i := random(#l)$Integer + 1; cons(l.i, shuf(delete(l, i))))
rprod(l : List SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) == if #l = 1 then first l else (i : NonNegativeInteger := (random(#l - 1)$Integer + 1)::NonNegativeInteger; rprod(first(l, i)) * rprod(rest(l, i)))
cs : List Integer := [1, 2, -1, 3]
build(e : List Integer, c : Integer) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients]) == rprod(shuf(concat([rp(e.i, atl.i) for i in 1..#atl | e.i ~= 0], [c::SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers, quotients])])))
ntr : Integer := 0
nbad : Integer := 0
ndiff : Integer := 0
for trial in 1..150 repeat
  e := [random(5)$Integer - 2 for i in 1..4]
  c := cs.(random(4)$Integer + 1)
  e1 := build(e, c)
  e2 := build(e, c)
  ntr := ntr + 1
  if not (e1 = e2)@Boolean then nbad := nbad + 1
  f := [random(5)$Integer - 2 for i in 1..4]
  d := cs.(random(4)$Integer + 1)
  if (e ~= f or c ~= d) and (e1 = build(f, d))@Boolean then ndiff := ndiff + 1
testTrue("(ntr = 150)@Boolean")
testTrue("(nbad = 0)@Boolean")
testTrue("(ndiff = 0)@Boolean")

testcase "powers without quotients: M4, exponents at least 1"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, powers])
x := 'x; y := 'y
testTrue("(x*x = x^2)@Boolean")
testTrue("not (x/x = 1)@Boolean")
testTrue("not (x^(-1)*x = 1)@Boolean")
testTrue("(x^(-1)*x^(-1) = (x^(-1))^2)@Boolean")

testcase "linear with powers and quotients"
(x, y) : SymbolicTerm(Integer, [commutativity, associativity, identities, numerals, linear, powers, quotients])
x := 'x; y := 'y
testTrue("(2*x*y+3*y*x = 5*x*y)@Boolean")
testTrue("(x*x-x^2 = 0)@Boolean")
testTrue("(x/y+x/y = 2*x/y)@Boolean")
testTrue("((x+y)^2 = (y+x)*(x+y))@Boolean")
testTrue("not (x*(x+1) = x^2+x)@Boolean")
testTrue("not (2*x*(y+1) = 2*x*y+2*x)@Boolean")
testTrue("(2*(x+y)/2 = x+y)@Boolean")
testTrue("(((2*x*(y+1))::Expression(Integer)) = 2*('x::Expression(Integer))*('y::Expression(Integer)) + 2*('x::Expression(Integer)))@Boolean")

statistics()
