-- Tests for the SymbolicPair prototype (src/algebra/sympair.spad), Option (c)
-- of the sexpr design review (FriCAS project doc claude/sexpr-q2-functionspace.md).
--
-- How to run (FriCAS 1.4.0 release; this file is not part of the build):
--   )compile sympair.spad          -- in a run directory
--   )lib )dir <that run directory>  -- in a later session, then
--   )read sympair.input
-- Not run by CI: CI does not install FriCAS.
--
-- Each test case states a property that the 2017 SymbolicExpression domain
-- violated (see claude/next-sexpr-port.md, defects D1, D7 and the Q2 note).

)set break resume
)expose UnittestCount UnittestAux Unittest

SP ==> SymbolicPair Integer

testsuite "SymbolicPair"

testcase "written form is kept"
(x, y) : SP
x := 'x; y := 'y
testTrue("(unparse(form((x+1)^2)) = _"(x+1)^2_")@Boolean")
testTrue("(unparse(form(x+x)) = _"x+x_")@Boolean")
testTrue("(unparse(form(eval((x+1)^2, x = y+1))) = _"(y+1+1)^2_")@Boolean")
testTrue("(unparse(form((x+1)^2-(x^2+2*x+1))) = _"(x+1)^2-(x^2+2*x+1)_")@Boolean")

testcase "equality and zero test agree"
(x, y) : SP
x := 'x; y := 'y
a := (x+1)^2 - (x^2+2*x+1)
b := (x+1)^2 - x^2
testTrue("zero? a")
testTrue("(a = 0)@Boolean")
testTrue("(zero? b) = ((b = 0)@Boolean)")
xftestTrue("zero? b")

testcase "integration is correct"
(x, y) : SP
x := 'x; y := 'y
F := integrate((x+1)^2, 'x)
G := integrate(1/(x^2+1), 'x)
H := integrate(sin(x)*cos(x), 'x)
testTrue("(D(F, 'x) = (x+1)^2)@Boolean")
testTrue("(D(G, 'x) = 1/(x^2+1))@Boolean")
testTrue("(D(H, 'x) = sin(x)*cos(x))@Boolean")
-- the 2017 domain returned x*(x+1)^2 and 0 for the first two integrals
xftestTrue("(D(x*(x+1)^2, 'x) = (x+1)^2)@Boolean")
xftestTrue("(G = 0)@Boolean")

testcase "summation and limits are correct"
(x, y) : SP
x := 'x; y := 'y
S := sum(x, 'x=1..10)
A := sum(x, 'x)
L := limit(sin(x)/x, x=0)
testTrue("(retract(S)@Integer = 55)@Boolean")
testTrue("(eval(A, x = x+1) - A = x)@Boolean")
testTrue("(retract(L::OrderedCompletion(SP))@SP = 1)@Boolean")
-- the 2017 domain returned 100
xftestTrue("(retract(S)@Integer = 100)@Boolean")

testcase "conversion from Expression does not read interpreter variables"
z := 5
e := (('z)::Expression(Integer) + 1)::SP
testTrue("(value(e) = ('z)::Expression(Integer) + 1)@Boolean")
testTrue("(unparse(form(e)) = _"z+1_")@Boolean")

testcase "rewrite rules act on the expression as written"
(x, y) : SP
x := 'x; y := 'y
t1 := cos(x)*sin(y) - cos(y)*sin(x)
t2 := - sin(x)*sin(y) + cos(x)*cos(y)
rs := _rule(cos(x)*sin(y)-sin(x)*cos(y), sin(y-x))
rc := _rule(cos(x)*cos(y)-sin(x)*sin(y), cos(x+y))
expr := tan(q)*tan(w) + t1*cos(x3) + t2*w*cos(a) + r3*t1*t2 + 5
testTrue("(rs t1 = sin(y-x))@Boolean")
testTrue("(rc t2 = cos(x+y))@Boolean")
testTrue("(rc rs expr = sin(y-x)*cos(x3) + cos(x+y)*w*cos(a) + r3*sin(y-x)*cos(x+y) + tan(q)*tan(w) + 5)@Boolean")
-- Expression R does not identify sin(y-x) with its expansion, so a rule
-- that did not fire would leave these false
xftestTrue("(t1 = sin(y-x))@Boolean")
xftestTrue("(rs t2 = cos(x+y))@Boolean")

statistics()
