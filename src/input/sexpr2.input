-- Unit tests for sexpr.spad (Symbolic, SymbolicExpression, ...).
-- Kurt Pagani's 2017 suite, updated for FriCAS 1.4.0 (2026).
-- Since 2026-11-26 SymbolicExpression is GeneralSymbolicExpression(R, A_P)
-- (src/algebra/gsexpr.spad); the suite tests Symbolic(Integer, A) with the
-- 2017 axiom set of the old SymbolicExpression, plus Annihilation, which that
-- domain applied unconditionally.  Its = is now Symbolic's own (syntactic).
--
-- Run with `make check` (also run by CI). In a FriCAS session, compile first:
--   )compile src/algebra/sexpr.spad
-- or, in a fresh session, load the compiled libraries TWICE:
--   )lib )dir <directory with the NRLIBs>
--   )lib )dir <directory with the NRLIBs>
-- FriCAS 1.4.0's )lib computes each constructor's COSIG when it is loaded,
-- and )lib )dir loads in reverse alphabetical order, so on the first pass
-- join and SymbolicFunctions1 are loaded before the categories Axiom and
-- SymbolicCategory and get wrong COSIGs (types then print as "Bad value").
--
-- Judge the run by statistics(): "unexpected failures: 0" and
-- "unexpected passes: 0".
--
-- History: from branch symbolic-expressions of billpage/fricas-dev (formerly
-- billpage/fricas), commit 933c5bb2f514d85249c87a0965ba4d6a144f01b8; the
-- history of this file in this repository was carried over from there.

)set break resume
)expose UnittestCount UnittestAux Unittest

-----------------
testsuite "SEXPR"
-----------------
-- ex1
-- ex2
-- ex3
-- ex4


---------------
testcase  "ex1"
---------------

SI0 ==> Symbolic(Integer,None)
X   ==> Expression Integer
SEI ==> Symbolic(Integer, join(join(join(join(join(join(join(join(join(join(Squares, Inverse), Identities), Doubles), Divides), CommutativePlus), CommutativeTimes), Cancels), AssociativePlus), AssociativeTimes), Annihilation))

-- no automatic simplifications
s:SI0 := 1+1+1
eins:=1::SI0
testEquals("s","eins+eins+eins")

ss:=simplify s
testEquals("ss","3::SI0")

sx:=s::Expression Integer
testEquals("sx","3::X")

sr:=retract s
test(s=3)
testEquals("sr","3::PositiveInteger")
-- RetractableTo AlgebraicNumber, required since upstream 7a12330c
testEquals("retract(s)@AlgebraicNumber","3::AlgebraicNumber")
testTrue("retractIfCan(sqrt(2)$SEI)@Union(AlgebraicNumber,_"failed_") case AlgebraicNumber")
testTrue("retractIfCan(('x)::SEI)@Union(AlgebraicNumber,_"failed_") case _"failed_"")

---------------
testcase  "ex2"
---------------
SI0 ==> Symbolic(Integer,None)
SEI ==> Symbolic(Integer, join(join(join(join(join(join(join(join(join(join(Squares, Inverse), Identities), Doubles), Divides), CommutativePlus), CommutativeTimes), Cancels), AssociativePlus), AssociativeTimes), Annihilation))
X   ==> Expression Integer

-- many automatic simplifications
(x,y,z):SEI
x::Expression Integer
x+x = 2*x
test %
testEquals("x+x","2*x")
xftestEquals("x+y","x*y")
xftestEquals("x*x","2*x")

x-x = 0
test %
testEquals("x-x","0")

x+y = y+x
test %
testEquals("x+y","y+x")

x+(y+z)= (x+y)+z
test %
testEquals("x+(y+z)","(x+y)+z")

x*x = x^2
test %
testEquals("x*x","x^2")

x/x = 1
test %
testEquals("x/x","1")

x*(1/x) = 1
test %
testEquals("x*(1/x)","1")

x*y = y*x
test %
testEquals("x*y","y*x")

x+1/y
simplify %
x*(y*z)= (x*y)*z
test %
testEquals("x*(y*z)","(x*y)*z")

x*(y+z) = x*y + x*z
test %
-- Symbolic does not distribute, so compare the values in Expression,
-- as test % above does; testEquals compares InputForms, i.e. syntax.
testEquals("x*(y+z)","(z+y)*x")
testTrue("((x*(y+z))::X = (z*x + y*x)::X)@Boolean")

smaller?(x*x,x*y)
testEquals("smaller?(x*x,x*y)","true")

smaller?(x*y,y*y)
testEquals("smaller?(x*y,y*y)","true")

xxxy:=x*x+x*y
yy:=y*y
smaller?(xxxy,yy)
testEquals("smaller?(xxxy,yy)","false")

x^2+2*x*y+y^2
factor(x^2+2*x*y+y^2)
testEquals("factor(x^2+2*x*y+y^2)","factor(x^2+2*x*y+y^2)")

expand((x+y)/z)
testEquals("expand((x+y)/z)","(x/z)+(y/z)")

expand(x*(y+z))
testTrue("((expand(x*(y+z)))::X = (z*x + y*x)::X)@Boolean")

x*z+y*z+x*y

--
exp(x+1) = %e*exp(x)
test map(simplify, %)
testEquals("map(simplify,exp(x+1) = exp(1)*exp(x))","true")

nthRoot(x, y)
nthRoot(x,2)=sqrt(x)
test %
testEquals("nthRoot(x,2)=sqrt(x)","true")

(nthRoot(x,2)=sqrt(x))@Boolean
testEquals("(nthRoot(x,2)=sqrt(x))@Boolean","true")


--
variables(sin(x*y)+2*z)
testEquals("variables(sin(x*y)+2*z)","[x,y,z]")

kernels(sin(x*y)+2*z)
testEquals("kernels(sin(x*y)+2*z)","[z,sin(x*y)]")


-- automatic boxing of sub-expressions
numer((1/x+1)/y*x+x^2/y)
-- 2017 expectation used %box kernels; sexpr.spad now wraps such terms in
-- %paren kernels (makeKernel). Kept as an expected failure until decided.
xftestEquals("numer((1/x+1)/y*x+x^2/y)","box((1/x+1)/y)*x+box(x^2/y)")

denom((1/x+1)/y*x+x^2/y)
testEquals("denom((1/x+1)/y*x+x^2/y)","1")

-- Symbolic Trig
smaller?(cos(y), sin(x))
testEquals("smaller?(cos(y), sin(x))","false")

smaller?(sin(x),cos(y))
testEquals("smaller?(sin(x),cos(y))","true")

cos(y)*sin(x)
sin(x)+cos(x)+tan(x)
asin(x)+acos(x)+atan(x)

sin(x)^2 + cos(x)^2 = 1
test map(simplify,%)
testEquals("map(simplify,sin(x)^2 + cos(x)^2 = 1)","true")

---------------
testcase  "ex3"
---------------
SI0 ==> Symbolic(Integer,None)
SEI ==> Symbolic(Integer, join(join(join(join(join(join(join(join(join(join(Squares, Inverse), Identities), Doubles), Divides), CommutativePlus), CommutativeTimes), Cancels), AssociativePlus), AssociativeTimes), Annihilation))
X   ==> Expression Integer


(x,y):SEI
r0:=(x+y)^2
rs := simplify r0
testTrue("((eval rs)::X = r0::X)@Boolean")

rf:=factor rs
testTrue("((eval rs)::X = r0::X)@Boolean")

convert(r)$SEI
testEquals("dom convert(r)$SEI","dom(1::InputForm)")

coerce(r)$SEI
testEquals("dom coerce(r)$SEI","dom(1::OutputForm)")

-- Wrong result !!
sum(x,'x=1..10)

s10:=reduce(+,[n::SEI for n in 1..10])
testEquals("s10","55")
testEquals("dom s10","dom x")


(x+y)^x
exp(-x)
-x
exp(-x)::InputForm
f:=operator 'f
f(x)
f(0$SEI)
f(0$EXPR INT)
D(x^2,'x)
simplify %

testEquals("simplify D(x^2,'x)","2*x")

x^n
-- Known problems
-- 1) need to handle %diff operator
--D(x^n,'x)
--D(p^n,'p)
--

---------------
testcase  "ex4"
---------------
SI0 ==> Symbolic(Integer,None)
SEI ==> Symbolic(Integer, join(join(join(join(join(join(join(join(join(join(Squares, Inverse), Identities), Doubles), Divides), CommutativePlus), CommutativeTimes), Cancels), AssociativePlus), AssociativeTimes), Annihilation))
X   ==> Expression Integer

--(x,y,z,a,q,w,x3,r3):SEI
(x,y,z):SEI

-- Rewrite Rules
-- Interpreter bug: to ensure proper types need _rule(x,y) instead of rule x==y
--
ru1:=_rule(x,y)
ru1(z)
ru2:=_rule(x+1,y)
ru2(z+1)
ru3:=_rule(cos(x), z)
ru3 cos(x)+sin(y)
ru3 cos(x)*sin(y)
--
t1 := cos(x)*sin(y) - cos(y)*sin(x)
t2 := - sin(x)*sin(y) + cos(x)*cos(y)

)set mess time on
expr := tan(q)*tan(w) + t1*cos(x3) + t2*w*cos(a) + r3*t1*t2 + 5
)set mess time off

rs:=_rule(cos(x)*sin(y)-sin(x)*cos(y), sin(y-x))
rc:=_rule(cos(x)*cos(y)-sin(x)*sin(y), cos(x+y))

rs t1
testEquals("rs t1","sin(y-x)")

rs t2
testEquals("rs t2","-sin(x)*sin(y)+cos(x)*cos(y)")

rc t1
testEquals("rc t1","cos(x)*sin(y)-cos(y)*sin(x)")


rc t2
testEquals("rc t2","cos(y+x)")

-- rc rs expr: removed 2026-11-26.  With Symbolic's own (syntactic) =, applying
-- the rule set to expr does not terminate; this was already so on main before
-- the changes of that date, and the old SymbolicExpression avoided it only
-- through its semantic =.  The same example runs on the new SymbolicExpression
-- in src/input/gsexpr.input ("rewrite rules act on the expression as written").
--testEquals("rc rs expr","")

-------------------------------------------
testcase "Doubles: coefficient on either side"
-------------------------------------------
SEI ==> Symbolic(Integer, join(join(join(join(join(join(join(join(join(join(Squares, Inverse), Identities), Doubles), Divides), CommutativePlus), CommutativeTimes), Cancels), AssociativePlus), AssociativeTimes), Annihilation))
-- CommutativeTimes sorts x*n to n*x; Doubles used to see only x*n, so
-- 2*x+3*x stayed as 3*x+2*x.
(x, y) : SEI
x := 'x; y := 'y
testTrue("(unparse(convert(2*x+3*x)@InputForm) = _"5*x_")@Boolean")
testTrue("(unparse(convert(x*2+x*3)@InputForm) = _"5*x_")@Boolean")
testTrue("(unparse(convert(x+(x+y))@InputForm) = _"2*x+y_")@Boolean")
testTrue("(unparse(convert((y+x)+x)@InputForm) = _"2*x+y_")@Boolean")
xftestTrue("(unparse(convert(2*x+3*x)@InputForm) = _"3*x+2*x_")@Boolean")
-- Symbolic(Integer, Doubles) alone keeps the coefficient on the right
(u, v) : Symbolic(Integer, Doubles)
u := 'u
testTrue("(unparse(convert(u*2+u*3)@InputForm) = _"u*5_")@Boolean")

-------------------------------------------------------------
testcase "G3: Symbolic(Integer, None) keeps the written form (spec 4.2)"
-------------------------------------------------------------
-- Until 2026-11-26 these were rewritten even without axioms.
(x, y) : Symbolic(Integer, None)
x := 'x; y := 'y
p2 : PositiveInteger := 2
p3 : PositiveInteger := 3
n3 : Integer := 3
f(t : Symbolic(Integer, None)) : String == unparse(convert(t)@InputForm)
testTrue("(f(0*x) = _"0*x_")@Boolean")
testTrue("(f(x*0) = _"x*0_")@Boolean")
testTrue("(f(0-y) = _"0-y_")@Boolean")
testTrue("(f(1/(x/y)) = _"1/(x/y)_")@Boolean")
testTrue("(f(-(x-y)) = _"-(x-y)_")@Boolean")
testTrue("(f(-(x+y)) = _"-(x+y)_")@Boolean")
testTrue("(f(p2*x) = _"2*x_")@Boolean")
testTrue("(f(p2*x + p3*x) = _"2*x+3*x_")@Boolean")
testTrue("(f(x^p3) = _"x^3_")@Boolean")
testTrue("(f(x^n3) = _"x^3_")@Boolean")
testTrue("(f(x^(-2)) = _"x^(-2)_")@Boolean")
testTrue("(f(x^(2/3)) = _"x^(2/3)_")@Boolean")
-- must fail: the 2017 behaviour
xftestTrue("(f(p2*x) = _"x+x_")@Boolean")
-- the same inputs are still rewritten when the axioms are present
SEI ==> Symbolic(Integer, join(join(join(join(join(join(join(join(join(join(Squares, Inverse), Identities), Doubles), Divides), CommutativePlus), CommutativeTimes), Cancels), AssociativePlus), AssociativeTimes), Annihilation))
(u, v) : SEI
u := 'x; v := 'y
g(t : SEI) : String == unparse(convert(t)@InputForm)
testTrue("(g(0*u) = _"0_")@Boolean")
testTrue("(g(0-v) = _"-(y)_")@Boolean")

-------------------------------------------------------------
testcase "Ord: the term order is a strict total order (spec 3.5)"
-------------------------------------------------------------
lt(a : InputForm, b : InputForm) : Boolean == smaller?(a, b)$SymbolicTermOrder
ts : List InputForm := concat([parse(s)$InputForm for s in ["0", "1", "2", "-1", "1/2", "2/4", "3/2", "4/2", "x", "y", "z", "a1", "x+y", "y+x", "x+1", "1+x", "x*y", "y*x", "sin(x)", "sin(y)", "cos(x)", "f(x,y)", "f(x)", "f(y,x)", "x^2", "x^(1/2)", "-x", "-(x+y)", "(x+y)+z", "x+(y+z)", "1/x", "x/1", "1.5", "2.5"]], [convert(-3)@InputForm, convert(1.5::Float)@InputForm, convert("s")@InputForm])
#ts
nIrr := #[a for a in ts | lt(a, a)]
nTot : Integer := 0
for a in ts repeat
  for b in ts repeat
    if not (a = b)@Boolean and not (lt(a, b) or lt(b, a)) then nTot := nTot + 1
    if lt(a, b) and lt(b, a) then nTot := nTot + 1
nTrans : Integer := 0
for a in ts repeat
  for b in ts repeat
    if lt(a, b) then
      for c in ts repeat
        if lt(b, c) and not lt(a, c) then nTrans := nTrans + 1
testTrue("(nIrr = 0)@Boolean")
testTrue("(nTot = 0)@Boolean")
testTrue("(nTrans = 0)@Boolean")
-- intended positions
testTrue("lt(parse(_"1_")$InputForm, parse(_"x_")$InputForm)")
testTrue("lt(parse(_"x_")$InputForm, parse(_"y_")$InputForm)")
testTrue("lt(parse(_"x_")$InputForm, parse(_"sin(x)_")$InputForm)")
testTrue("lt(parse(_"cos(x)_")$InputForm, parse(_"sin(x)_")$InputForm)")
testTrue("lt(parse(_"sin(x)_")$InputForm, parse(_"sin(y)_")$InputForm)")
testTrue("lt(parse(_"f(x)_")$InputForm, parse(_"f(x,y)_")$InputForm)")
testTrue("lt(parse(_"1/2_")$InputForm, parse(_"1_")$InputForm)")
testTrue("lt(parse(_"2_")$InputForm, parse(_"4/2_")$InputForm)")
testTrue("lt(parse(_"1/2_")$InputForm, parse(_"2/4_")$InputForm)")
testTrue("lt(convert(-3)@InputForm, parse(_"0_")$InputForm)")
-- must fail: irreflexive
xftestTrue("lt(parse(_"x_")$InputForm, parse(_"x_")$InputForm)")

