-- Tests for GeneralSymbolicExpression(R, A) (src/algebra/gsexpr.spad): design (I) of the
-- specification docs/spec/sexpr-spec.md.  A_P below is the default
-- presentation axiom set [identities, annihilation, involutions, numerals]
-- of spec section 4.1; check(x) is the invariant test (Val), V1 in spec 6.
--
-- Run with `make check` (also run by CI), or in a FriCAS session:
--   )compile src/algebra/gsexpr.spad
--   )read src/input/gsexpr.input
-- Judge the run by statistics(): "unexpected failures: 0" and
-- "unexpected passes: 0".
-- testsuite and testcase clear macros as well as variables, so each test
-- case names GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals]) in full.
--
-- Each test case states a property that the 2017 SymbolicExpression domain
-- violated (docs/notes/2026-11-24-design-review.md, defects D1, D7, and
-- docs/notes/2026-11-25-q2-functionspace.md).

)set break resume
)expose UnittestCount UnittestAux Unittest

testsuite "GeneralSymbolicExpression"

testcase "written form is kept"
(x, y) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])
x := 'x; y := 'y
testTrue("(unparse(form((x+1)^2)) = _"(x+1)^2_")@Boolean")
testTrue("(unparse(form(x+x)) = _"x+x_")@Boolean")
testTrue("(unparse(form(eval((x+1)^2, x = y+1))) = _"(y+1+1)^2_")@Boolean")
testTrue("(unparse(form((x+1)^2-(x^2+2*x+1))) = _"(x+1)^2-(x^2+2*x+1)_")@Boolean")

testcase "equality and zero test agree"
(x, y) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])
x := 'x; y := 'y
a := (x+1)^2 - (x^2+2*x+1)
b := (x+1)^2 - x^2
testTrue("zero? a")
testTrue("(a = 0)@Boolean")
testTrue("((zero? b) = ((b = 0)@Boolean))@Boolean")
xftestTrue("zero? b")

testcase "integration is correct"
(x, y) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])
x := 'x; y := 'y
F := integrate((x+1)^2, 'x)
G := integrate(1/(x^2+1), 'x)
H := integrate(sin(x)*cos(x), 'x)
testTrue("(D(F, 'x) = (x+1)^2)@Boolean")
testTrue("(D(G, 'x) = 1/(x^2+1))@Boolean")
testTrue("(D(H, 'x) = sin(x)*cos(x))@Boolean")
testTrue("check(F) and check(G) and check(H)")
-- the 2017 domain returned x*(x+1)^2 and 0 for the first two integrals
xftestTrue("(D(x*(x+1)^2, 'x) = (x+1)^2)@Boolean")
xftestTrue("(G = 0)@Boolean")

testcase "summation and limits are correct"
(x, y) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])
x := 'x; y := 'y
S := sum(x, 'x=1..10)
A := sum(x, 'x)
L := limit(sin(x)/x, x=0)
testTrue("(retract(S)@Integer = 55)@Boolean")
testTrue("(unparse(form(S)) = _"55_")@Boolean")
testTrue("check(S) and check(A)")
testTrue("(eval(A, x = x+1) - A = x)@Boolean")
testTrue("(retract(L::OrderedCompletion(GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])))@GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals]) = 1)@Boolean")
-- the 2017 domain returned 100
xftestTrue("(retract(S)@Integer = 100)@Boolean")

testcase "conversion from Expression does not read interpreter variables"
z := 5
e := (('z)::Expression(Integer) + 1)::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])
testTrue("(value(e) = ('z)::Expression(Integer) + 1)@Boolean")
testTrue("(unparse(form(e)) = _"z+1_")@Boolean")

testcase "rewrite rules act on the expression as written"
(x, y) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])
x := 'x; y := 'y
t1 := cos(x)*sin(y) - cos(y)*sin(x)
t2 := - sin(x)*sin(y) + cos(x)*cos(y)
rs := _rule(cos(x)*sin(y)-sin(x)*cos(y), sin(y-x))
rc := _rule(cos(x)*cos(y)-sin(x)*sin(y), cos(x+y))
expr := tan(q)*tan(w) + t1*cos(x3) + t2*w*cos(a) + r3*t1*t2 + 5
testTrue("(rs t1 = sin(y-x))@Boolean")
testTrue("(rc t2 = cos(x+y))@Boolean")
testTrue("(rc rs expr = sin(y-x)*cos(x3) + cos(x+y)*w*cos(a) + r3*sin(y-x)*cos(x+y) + tan(q)*tan(w) + 5)@Boolean")
-- Expression R does not identify sin(y-x) with its expansion, so a rule
-- that did not fire would leave these false
xftestTrue("(t1 = sin(y-x))@Boolean")
xftestTrue("(rs t2 = cos(x+y))@Boolean")
testTrue("check(rc rs expr)")

testcase "presentation axioms A_P (spec 4.1)"
(x, y) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])
x := 'x; y := 'y
-- identities
testTrue("(unparse(form(x+0)) = _"x_")@Boolean")
testTrue("(unparse(form(0+x)) = _"x_")@Boolean")
testTrue("(unparse(form(x-0)) = _"x_")@Boolean")
testTrue("(unparse(form(0-x)) = _"-(x)_")@Boolean")
testTrue("(unparse(form(1*x)) = _"x_")@Boolean")
testTrue("(unparse(form(x/1)) = _"x_")@Boolean")
testTrue("(unparse(form(x^1)) = _"x_")@Boolean")
testTrue("(unparse(form(x^0)) = _"1_")@Boolean")
-- annihilation
testTrue("(unparse(form(0*x)) = _"0_")@Boolean")
testTrue("(unparse(form(x*0)) = _"0_")@Boolean")
-- involutions
testTrue("(unparse(form(-(-x))) = _"x_")@Boolean")
testTrue("(unparse(form(1/(1/x))) = _"x_")@Boolean")
-- numerals
testTrue("(unparse(form(1+(2::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])))) = _"3_")@Boolean")
testTrue("(unparse(form((1::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals]))/2+5)) = _"11/2_")@Boolean")
testTrue("(unparse(form((2::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals]))^10)) = _"1024_")@Boolean")
-- nothing else is rewritten (G1): near misses keep their form
testTrue("(unparse(form(x+x)) = _"x+x_")@Boolean")
testTrue("(unparse(form(x-x)) = _"x-x_")@Boolean")
testTrue("(unparse(form(y+x)) = _"y+x_")@Boolean")
testTrue("(unparse(form(x*(y+1))) = _"x*(y+1)_")@Boolean")
xftestTrue("(unparse(form(x+x)) = _"2*x_")@Boolean")
-- invariant V1 on rule results
testTrue("check(0-x) and check(1/(1/x)) and check(x^0) and check((1::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals]))/2+5)")

testcase "identities only: numbers are not folded (G3)"
(x, y) : GeneralSymbolicExpression(Integer, [identities])
x := 'x; y := 'y
testTrue("(unparse(form(1+(2::GeneralSymbolicExpression(Integer, [identities])))) = _"1+2_")@Boolean")
testTrue("(unparse(form(0*x)) = _"0*x_")@Boolean")
testTrue("(unparse(form(-(-x))) = _"-(-(x))_")@Boolean")
testTrue("(unparse(form(x+0)) = _"x_")@Boolean")
testTrue("((1+(2::GeneralSymbolicExpression(Integer, [identities]))) = 3)@Boolean")
xftestTrue("(unparse(form(1+(2::GeneralSymbolicExpression(Integer, [identities])))) = _"3_")@Boolean")

testcase "Disp: the displayed text reads back as the stored form (spec 5, G1)"
(a, b, c) : GeneralSymbolicExpression(Integer, [identities])
a := 'a; b := 'b; c := 'c
rt(t : GeneralSymbolicExpression(Integer, [identities])) : Boolean == (parse(concat(lines(formatExpression(precondition(t::OutputForm)$OutputFormTools)$Format1D)))$InputForm = form t)@Boolean
testTrue("rt((a+b)+c)")
testTrue("rt(a+(b+c))")
testTrue("rt((a-b)-c)")
testTrue("rt(a-(b-c))")
testTrue("rt(a-(b+c))")
testTrue("rt((a*b)*c)")
testTrue("rt(a*(b*c))")
testTrue("rt(a*(b/c))")
testTrue("rt((a/b)/c)")
testTrue("rt(a/(b/c))")
testTrue("rt(a/(b*c))")
testTrue("rt((a+b)/c)")
testTrue("rt(a/(b+c))")
testTrue("rt(a^(b^c))")
testTrue("rt((a^b)^c)")
testTrue("rt(-(a*b))")
testTrue("rt((-a)*b)")
testTrue("rt(-(a/b))")
testTrue("rt(a+(-b))")
testTrue("rt(a-(-b))")
testTrue("rt(a*(-b))")
testTrue("rt(-(a+b))")
testTrue("rt(-(-a))")
testTrue("rt((a+b)*c)")
testTrue("rt(a^(b+c))")
testTrue("rt((a*b)^c)")
testTrue("rt((a/b)^c)")
testTrue("rt(sin(a+b)*c)")
-- mixed arithmetic with integers keeps the written order
testTrue("rt(a*2) and rt(2*a) and rt(a+2) and rt(2+a) and rt(a-2) and rt(2-a)")
testTrue("rt(a/2) and rt(2/a) and rt(a^2) and rt(2^a) and rt(a*(1/2)) and rt((1/2)*a)")
testTrue("(unparse(form(a*2)) = _"a*2_")@Boolean")
xftestTrue("(unparse(form(a*2)) = _"2*a_")@Boolean")
-- must fail: a/(b/c) and (a/b)/c are different trees
xftestTrue("(parse(_"a/b/c_")$InputForm = form(a/(b/c)))@Boolean")

testcase "Assoc: rules (A) and (AN) (spec 4.1.1)"
(w, x, y, z) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity])
w := 'w; x := 'x; y := 'y; z := 'z
testTrue("(unparse(form(x+(y+z))) = _"x+y+z_")@Boolean")
testTrue("(unparse(form(x*(y*z))) = _"x*y*z_")@Boolean")
testTrue("(unparse(form(w+(x+(y+z)))) = _"w+x+y+z_")@Boolean")
testTrue("(unparse(form((x+(y+z))*w)) = _"(x+y+z)*w_")@Boolean")
-- (AN): adjacent numerals fold whatever the grouping
testTrue("(unparse(form(x+(1+(2::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]))))) = _"x+3_")@Boolean")
testTrue("(unparse(form((x+1)+2)) = _"x+3_")@Boolean")
testTrue("(unparse(form(1+((2::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]))+x))) = _"3+x_")@Boolean")
testTrue("(unparse(form((x*2)*3)) = _"x*6_")@Boolean")
-- numerals separated by a term need commutativity: not folded
testTrue("(unparse(form((1+x)+2)) = _"1+x+2_")@Boolean")
-- only + and * are associative
testTrue("(unparse(form(x-(y-z))) = _"x-(y-z)_")@Boolean")
testTrue("(unparse(form(x+(y-z))) = _"x+(y-z)_")@Boolean")
testTrue("(unparse(form(x*(y/z))) = _"x*(y/z)_")@Boolean")
xftestTrue("(unparse(form(x+(y+z))) = _"x+(y+z)_")@Boolean")
testTrue("check(w+(x+(y+z))) and check((x+1)+2) and check((x*2)*3) and check((1+x)+2)")
rt(t : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity])) : Boolean == (parse(concat(lines(formatExpression(precondition(t::OutputForm)$OutputFormTools)$Format1D)))$InputForm = form t)@Boolean
testTrue("rt(w+(x+(y+z))) and rt((x+(y+z))*w) and rt((1+x)+2)")

testcase "Assoc: not in A_P (decision 0005)"
(x, y, z) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])
x := 'x; y := 'y; z := 'z
testTrue("(unparse(form(x+(y+z))) = _"x+(y+z)_")@Boolean")
testTrue("(unparse(form((x+1)+2)) = _"x+1+2_")@Boolean")

testcase "Assoc: all bracketings agree (spec 4.1.1, confluence)"
lv : List GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]) := ['x, 'y, 0, 1, 2]
pl(u : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]), v : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity])) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]) == u + v
ml(u : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]), v : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity])) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]) == u * v
br(op : (GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]), GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity])) -> GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]), a : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]), b : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]), c : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]), d : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity])) : List GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity]) == [op(op(op(a,b),c),d), op(op(a,op(b,c)),d), op(op(a,b),op(c,d)), op(a,op(op(b,c),d)), op(a,op(b,op(c,d)))]
bad : List String := []
nchk : Integer := 0
for a in lv repeat
  for b in lv repeat
    for c in lv repeat
      for d in lv repeat
        for op in [pl, ml] repeat
          ts := br(op, a, b, c, d)
          fs := [unparse(form t) for t in ts]
          if #removeDuplicates(fs) > 1 then bad := cons(first fs, bad)
          for t in ts repeat
            if not check(t) then nchk := nchk + 1
#bad
first(bad, min(#bad, 5))
testTrue("empty? bad")
testTrue("(nchk = 0)@Boolean")

testcase "SymbolicExpression(R) is GeneralSymbolicExpression(R, A_P) (decisions 0002, 0006)"
(x, y) : SymbolicExpression(Integer)
x := 'x; y := 'y
testTrue("(unparse(form(sum(x, 'x=1..10))) = _"55_")@Boolean")
testTrue("(unparse(form(1+(2::SymbolicExpression(Integer)))) = _"3_")@Boolean")
testTrue("(unparse(form((x+1)^2-(x^2+2*x+1))) = _"(x+1)^2-(x^2+2*x+1)_")@Boolean")
testTrue("zero?((x+1)^2-(x^2+2*x+1))")
testTrue("(D(integrate(x*sin(x), 'x), 'x) = x*sin(x))@Boolean")
testTrue("(unparse(form(0*y + x/1 + (-(-y)))) = _"x+y_")@Boolean")
-- associativity is not in A_P (decision 0005)
testTrue("(unparse(form(x+(y+1))) = _"x+(y+1)_")@Boolean")
testTrue("check(sum(x, 'x)) and check(x+(y+1))")
xftestTrue("(unparse(form(1+(2::SymbolicExpression(Integer)))) = _"1+2_")@Boolean")

-------------------------------------------------------------
testcase "Ord: the term order is a strict total order (spec 3.5)"
-------------------------------------------------------------
lt(a : InputForm, b : InputForm) : Boolean == smaller?(a, b)$SymbolicTermOrder
ts : List InputForm := concat([parse(s)$InputForm for s in ["0", "1", "2", "-1", "1/2", "2/4", "3/2", "4/2", "x", "y", "z", "a1", "x+y", "y+x", "x+1", "1+x", "x*y", "y*x", "sin(x)", "sin(y)", "cos(x)", "f(x,y)", "f(x)", "f(y,x)", "x^2", "x^(1/2)", "-x", "-(x+y)", "(x+y)+z", "x+(y+z)", "1/x", "x/1", "1.5", "2.5"]], [convert(-3)@InputForm, convert(1.5::Float)@InputForm, convert("s")@InputForm])
#ts
nIrr := #[a for a in ts | lt(a, a)]
nTot : Integer := 0
for a in ts repeat
  for b in ts repeat
    if not (a = b)@Boolean and not (lt(a, b) or lt(b, a)) then nTot := nTot + 1
    if lt(a, b) and lt(b, a) then nTot := nTot + 1
nTrans : Integer := 0
for a in ts repeat
  for b in ts repeat
    if lt(a, b) then
      for c in ts repeat
        if lt(b, c) and not lt(a, c) then nTrans := nTrans + 1
testTrue("(nIrr = 0)@Boolean")
testTrue("(nTot = 0)@Boolean")
testTrue("(nTrans = 0)@Boolean")
-- intended positions
testTrue("lt(parse(_"1_")$InputForm, parse(_"x_")$InputForm)")
testTrue("lt(parse(_"x_")$InputForm, parse(_"y_")$InputForm)")
testTrue("lt(parse(_"x_")$InputForm, parse(_"sin(x)_")$InputForm)")
testTrue("lt(parse(_"cos(x)_")$InputForm, parse(_"sin(x)_")$InputForm)")
testTrue("lt(parse(_"sin(x)_")$InputForm, parse(_"sin(y)_")$InputForm)")
testTrue("lt(parse(_"f(x)_")$InputForm, parse(_"f(x,y)_")$InputForm)")
testTrue("lt(parse(_"1/2_")$InputForm, parse(_"1_")$InputForm)")
testTrue("lt(parse(_"2_")$InputForm, parse(_"4/2_")$InputForm)")
testTrue("lt(parse(_"1/2_")$InputForm, parse(_"2/4_")$InputForm)")
testTrue("lt(convert(-3)@InputForm, parse(_"0_")$InputForm)")
-- must fail: irreflexive
xftestTrue("lt(parse(_"x_")$InputForm, parse(_"x_")$InputForm)")


testcase "commutativity as a presentation group (spec 3.4): sorted display, value kept"
(x, y) : GeneralSymbolicExpression(Integer, [commutativity])
x := 'x; y := 'y
testTrue("(unparse(form(y+x)) = _"x+y_")@Boolean")
testTrue("(unparse(form(y*(x+1))) = _"y*(1+x)_")@Boolean")
testTrue("check(y+x) and check(y*(x+1))")
xftestTrue("(unparse(form(y+x)) = _"y+x_")@Boolean")
pl(u : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), v : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) == u + v
ml(u : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), v : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) == u * v
brs(op : (GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) -> GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), a : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), b : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), c : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), d : GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])) : List GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) == [op(op(op(a,b),c),d), op(op(a,op(b,c)),d), op(op(a,b),op(c,d)), op(a,op(op(b,c),d)), op(a,op(b,op(c,d)))]
perms(l : List Integer) : List List Integer == if empty? l then [empty()$List(Integer)] else concat [[cons(l.i, q) for q in perms(delete(l, i))] for i in 1..#l]
P := perms([1, 2, 3, 4])
lv : List GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]) := [('x)::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), ('y)::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), 1::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity]), 2::GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals, associativity, commutativity])]
n := #lv
nms : Integer := 0
nbad : Integer := 0
nchk : Integer := 0
for i in 1..n repeat
  for j in i..n repeat
    for k in j..n repeat
      for m in k..n repeat
        ms := [lv.i, lv.j, lv.k, lv.m]
        nms := nms + 1
        for op in [pl, ml] repeat
          ts := concat [brs(op, ms.(q.1), ms.(q.2), ms.(q.3), ms.(q.4)) for q in P]
          if #removeDuplicates([unparse(form t) for t in ts]) > 1 then nbad := nbad + 1
          for t in ts repeat
            if not check(t) or not (t = first ts)@Boolean then nchk := nchk + 1
testTrue("(nms = 35)@Boolean")
testTrue("(nbad = 0)@Boolean")
testTrue("(nchk = 0)@Boolean")

statistics()
