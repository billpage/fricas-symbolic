0 :: GeneralSymbolicExpression(Integer, [foo])
0 :: SymbolicTerm(Integer, [identities, numerals, associativity, commutativity, linear, powers, quotients, ring])
0 :: SymbolicTerm(Integer, [identities, numerals, associativity, commutativity, linear, powers, quotients, ring, field])
