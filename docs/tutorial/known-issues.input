-- Reproduction of the two known problems with SymbolicExpression(Integer)
-- described in docs/tutorial/tutorial.md, section "Known issues".
--
-- Run it in ONE fresh FriCAS session (the second problem depends on what the
-- session has done before):
--   )compile src/algebra/gsexpr.spad
--   )read docs/tutorial/known-issues.input
-- Commit 54811c7, FriCAS 1.4.0.  GeneralSymbolicExpression(Integer, A_P) is the
-- domain that SymbolicExpression(Integer) is defined to be; it is used here as
-- the control.

)set break resume

-- ==== sum-before
SE ==> SymbolicExpression Integer
GA ==> GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])
x : SE := 'x
y : GA := 'y
sum(x, 'x=1..10)
sum(y, 'y=1..10)

-- ==== integral-atan
integrate(1/(x^2+1), 'x)
integrate(1/(y^2+1), 'y)
integrate(1/(x^2+2), 'x)
integrate(1/(y^2+2), 'y)
integrate(x/(x^2+1), 'x)
integrate(y/(y^2+1), 'y)

-- ==== sum-after
integrate(sin(x)*cos(x), 'x)
sum(x, 'x=1..10)
sum(x, 'x)
sum(y, 'y=1..10)

-- ==== sum-division
sum(x^2, 'x=1..3)
sum(y^2, 'y=1..3)
