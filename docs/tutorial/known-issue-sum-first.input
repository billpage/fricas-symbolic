-- Control for known-issue-integrate-first.input: the same commands, but the
-- first library algorithm called in the session is sum.  Run it in a FRESH
-- FriCAS session:
--   )compile src/algebra/gsexpr.spad
--   )read docs/tutorial/known-issue-sum-first.input
-- Commit 54811c7, FriCAS 1.4.0.

)set break resume

-- ==== setup
SE ==> SymbolicExpression Integer
GA ==> GeneralSymbolicExpression(Integer, [identities, annihilation, involutions, numerals])
x : SE := 'x
y : GA := 'y

-- ==== sums
sum(x, 'x=1..10)
sum(x, 'x)
sum(y, 'y=1..10)
sum(y, 'y)

-- ==== integral-atan
integrate(1/(x^2+1), 'x)
integrate(1/(y^2+1), 'y)
integrate(1/(x^2+2), 'x)
integrate(1/(y^2+2), 'y)
integrate(x/(x^2+1), 'x)
integrate(y/(y^2+1), 'y)

-- ==== sum-division
sum(x^2, 'x=1..3)
sum(y^2, 'y=1..3)
