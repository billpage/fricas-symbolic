)abbrev package LNCHK LeanCrossCheck
++ Description:
++ Differential test of the Lean normaliser (lean/FricasSymbolic/CrossCheck.lean)
++ against GeneralSymbolicExpression(Integer, A): the same pseudo-random terms,
++ the same generator, the count and a checksum of the printed forms.
LeanCrossCheck(A : List Symbol) : with
    run : (Integer, Integer, Integer) -> List Integer
      ++ run(s0, n, d) builds n terms of depth d from seed s0 and returns
      ++ [n, checksum of their forms].
    forms : (Integer, Integer, Integer) -> List String
      ++ forms(s0, n, d) are the printed forms of those terms.
  == add
    G ==> GeneralSymbolicExpression(Integer, A)
    st : Reference Integer := ref 0
    nxt() : Integer ==
        setref(st, (deref st * 1103515245 + 12345) rem 2147483648)
        deref st
    pick(n : Integer) : Integer == (nxt() quo 65536) rem n
    -- the form as one line: Lisp's pretty-printer breaks long forms at a
    -- space and indents the next line
    fstr(t : G) : String ==
        s := PRINC_-TO_-STRING(form t)$Lisp pretend String
        r : List Character := empty()
        skip := false
        for j in 1..#s repeat
            c := s.j
            if c = char(10) then
                r := cons(char " ", r)
                skip := true
            else if skip and c = char " " then skip := true
            else
                skip := false
                r := cons(c, r)
        construct(reverse! r)$String
    leaf(safe : Boolean) : G ==
        j := pick 7
        j = 0 => (if safe then 3 else 0)::Integer::G
        j = 1 => 1::Integer::G
        j = 2 => 2::Integer::G
        j = 3 => (-1)::Integer::G
        j = 4 => ('x)::Symbol::G
        j = 5 => ('y)::Symbol::G
        (1/2)::Fraction(Integer)::G
    gen(d : Integer, safe : Boolean) : G ==
        d = 0 => leaf safe
        if safe then
            k := pick 5
            k = 0 => leaf true
            k = 1 =>
                a := gen(d - 1, true)
                b := gen(d - 1, true)
                a * b
            k = 2 =>
                a := gen(d - 1, true)
                b := gen(d - 1, true)
                a / b
            k = 3 =>
                a := gen(d - 1, true)
                - a
            e := pick 5 - 2
            a := gen(d - 1, true)
            a ^ e
        else
            k := pick 8
            k = 1 =>
                a := gen(d - 1, false)
                b := gen(d - 1, false)
                a + b
            k = 2 =>
                a := gen(d - 1, false)
                b := gen(d - 1, false)
                a - b
            k = 3 =>
                a := gen(d - 1, false)
                - a
            k = 4 =>
                a := gen(d - 1, false)
                b := gen(d - 1, false)
                a * b
            k = 5 =>
                a := gen(d - 1, false)
                b := gen(d - 1, true)
                a / b
            k = 6 =>
                e := pick 5 - 2
                a := gen(d - 1, e < 0)
                a ^ e
            leaf false
    run(s0 : Integer, n : Integer, d : Integer) : List Integer ==
        setref(st, s0)
        h : Integer := 0
        for i in 1..n repeat
            s := fstr gen(d, false)
            for j in 1..#s repeat h := (h * 31 + ord(s.j)) rem 1000000007
            h := (h * 31 + 59) rem 1000000007
        [n, h]
    forms(s0 : Integer, n : Integer, d : Integer) : List String ==
        setref(st, s0)
        [fstr gen(d, false) for i in 1..n]
