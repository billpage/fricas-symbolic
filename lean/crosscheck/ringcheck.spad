)abbrev package LNRING LeanRingCheck
++ Description:
++ Differential test of the Lean mirror of the Ring rung
++ (lean/FricasSymbolic/RingMirror.lean) against
++ GeneralSymbolicExpression(Integer, A) for A containing ring: the same
++ pseudo-random terms, the count and a checksum of the printed forms.
LeanRingCheck(A : List Symbol) : with
    run : (Integer, Integer, Integer) -> List Integer
      ++ run(s0, n, d) builds n terms of depth d from seed s0 and returns
      ++ [n, checksum of their forms].
    forms : (Integer, Integer, Integer) -> List String
      ++ forms(s0, n, d) are the printed forms of those terms.
  == add
    G ==> GeneralSymbolicExpression(Integer, A)
    st : Reference Integer := ref 0
    nxt() : Integer ==
        setref(st, (deref st * 1103515245 + 12345) rem 2147483648)
        deref st
    pick(n : Integer) : Integer == (nxt() quo 65536) rem n
    -- the form printed by hand: PRINC-TO-STRING would print a subtree that
    -- occurs twice with Lisp's shared-structure labels (#1= ... #1#)
    istr(f : InputForm) : String ==
        integer?(f)$InputForm => string(integer(f)$InputForm)
        symbol?(f)$InputForm => string(symbol(f)$InputForm)
        atom?(f)$InputForm => unparse(f)$InputForm
        l := destruct(f)$InputForm
        r := concat("(", istr first l)
        for a in rest l repeat r := concat([r, " ", istr a])
        concat(r, ")")
    fstr(t : G) : String == istr form t
    leaf(safe : Boolean) : G ==
        j := pick 7
        j = 0 => (if safe then 3 else 0)::Integer::G
        j = 1 => 1::Integer::G
        j = 2 => 2::Integer::G
        j = 3 => (-1)::Integer::G
        j = 4 => ('x)::Symbol::G
        j = 5 => ('y)::Symbol::G
        ('z)::Symbol::G
    gen(d : Integer, safe : Boolean) : G ==
        d = 0 => leaf safe
        if safe then
            k := pick 4
            k = 1 =>
                a := gen(d - 1, true)
                b := gen(d - 1, true)
                a * b
            k = 2 =>
                e := pick 5 - 1
                a := gen(d - 1, true)
                a ^ e
            k = 3 =>
                a := gen(d - 1, true)
                - a
            leaf true
        else
            k := pick 9
            k = 1 =>
                a := gen(d - 1, false)
                b := gen(d - 1, false)
                a + b
            k = 2 =>
                a := gen(d - 1, false)
                b := gen(d - 1, false)
                a - b
            k = 3 =>
                a := gen(d - 1, false)
                - a
            k = 4 =>
                a := gen(d - 1, false)
                b := gen(d - 1, false)
                a * b
            k = 5 =>
                a := gen(d - 1, false)
                c := pick 4 + 1
                a / (c::Integer::G)
            k = 6 =>
                a := gen(d - 1, false)
                b := gen(d - 1, true)
                a / b
            k = 7 =>
                e := pick 5 - 1
                a := gen(d - 1, e < 0)
                a ^ e
            leaf false
    run(s0 : Integer, n : Integer, d : Integer) : List Integer ==
        setref(st, s0)
        h : Integer := 0
        for i in 1..n repeat
            s := fstr gen(d, false)
            for j in 1..#s repeat h := (h * 31 + ord(s.j)) rem 1000000007
            h := (h * 31 + 59) rem 1000000007
        [n, h]
    forms(s0 : Integer, n : Integer, d : Integer) : List String ==
        setref(st, s0)
        [fstr gen(d, false) for i in 1..n]
