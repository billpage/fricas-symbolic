import FricasSymbolic.Normalize

/-!
# Part 1: the axioms as a rewriting system (spec §2.4, §4.1, §4.1.1)

`Root A l r` lists the rules of spec §4.1 (groups Id, Ann, Inv, Num) and §4.1.1
((A) and (AN)), each with its side conditions, written from the spec's tables
and not from the Spad code. `Step A` closes them under contexts; `IsNF A t`
says that no step applies to `t`.

Numerals `n`, `m` of the spec are `.num q`; a numeral "of value 0" is `.num 0`.
-/

namespace FricasSymbolic

open Term

/-- The rules of `A` applied at the root of a term. -/
inductive Root (A : Ax) : Term → Term → Prop
  -- Identities (Id)
  | id_add_l (x : Term) : A.id → Root A (.add (.num 0) x) x
  | id_add_r (x : Term) : A.id → Root A (.add x (.num 0)) x
  | id_sub_r (x : Term) : A.id → Root A (.sub x (.num 0)) x
  | id_sub_l (x : Term) : A.id → Root A (.sub (.num 0) x) (.neg x)
  | id_mul_l (x : Term) : A.id → Root A (.mul (.num 1) x) x
  | id_mul_r (x : Term) : A.id → Root A (.mul x (.num 1)) x
  | id_div (x : Term) : A.id → Root A (.div x (.num 1)) x
  | id_pow1 (x : Term) : A.id → Root A (.pow x 1) x
  | id_pow0 (x : Term) : A.id → Root A (.pow x 0) (.num 1)
  -- Annihilation (Ann)
  | ann_l (x : Term) : A.ann → Root A (.mul (.num 0) x) (.num 0)
  | ann_r (x : Term) : A.ann → Root A (.mul x (.num 0)) (.num 0)
  -- Involutions (Inv)
  | inv_neg (x : Term) : A.inv → Root A (.neg (.neg x)) x
  | inv_div (x : Term) : A.inv → Root A (.div (.num 1) (.div (.num 1) x)) x
  -- Numerals (Num): evaluation, when defined
  | num_add (p q : ℚ) : A.num → Root A (.add (.num p) (.num q)) (.num (p + q))
  | num_sub (p q : ℚ) : A.num → Root A (.sub (.num p) (.num q)) (.num (p - q))
  | num_mul (p q : ℚ) : A.num → Root A (.mul (.num p) (.num q)) (.num (p * q))
  | num_neg (p : ℚ) : A.num → Root A (.neg (.num p)) (.num (-p))
  | num_div (p q : ℚ) : A.num → q ≠ 0 → Root A (.div (.num p) (.num q)) (.num (p / q))
  | num_pow (p : ℚ) (n : ℤ) : A.num → ¬ (p = 0 ∧ n < 0) →
      Root A (.pow (.num p) n) (.num (p ^ n))
  -- Associativity (A), §4.1.1
  | assoc_add (x y z : Term) : A.assoc → Root A (.add x (.add y z)) (.add (.add x y) z)
  | assoc_mul (x y z : Term) : A.assoc → Root A (.mul x (.mul y z)) (.mul (.mul x y) z)
  -- its completion with Num, (AN), §4.1.1
  | an_add (x : Term) (n m : ℚ) : A.assoc → A.num → A.an →
      Root A (.add (.add x (.num n)) (.num m)) (.add x (.num (n + m)))
  | an_mul (x : Term) (n m : ℚ) : A.assoc → A.num → A.an →
      Root A (.mul (.mul x (.num n)) (.num m)) (.mul x (.num (n * m)))

/-- One rewrite step: a rule of `A` applied at any position. -/
inductive Step (A : Ax) : Term → Term → Prop
  | root {s t : Term} : Root A s t → Step A s t
  | add_l {a a' : Term} (b : Term) : Step A a a' → Step A (.add a b) (.add a' b)
  | add_r (a : Term) {b b' : Term} : Step A b b' → Step A (.add a b) (.add a b')
  | sub_l {a a' : Term} (b : Term) : Step A a a' → Step A (.sub a b) (.sub a' b)
  | sub_r (a : Term) {b b' : Term} : Step A b b' → Step A (.sub a b) (.sub a b')
  | neg {a a' : Term} : Step A a a' → Step A (.neg a) (.neg a')
  | mul_l {a a' : Term} (b : Term) : Step A a a' → Step A (.mul a b) (.mul a' b)
  | mul_r (a : Term) {b b' : Term} : Step A b b' → Step A (.mul a b) (.mul a b')
  | div_l {a a' : Term} (b : Term) : Step A a a' → Step A (.div a b) (.div a' b)
  | div_r (a : Term) {b b' : Term} : Step A b b' → Step A (.div a b) (.div a b')
  | pow {a a' : Term} (n : ℤ) : Step A a a' → Step A (.pow a n) (.pow a' n)

/-- `t` is a normal form: no step applies. -/
def IsNF (A : Ax) (t : Term) : Prop := ∀ t', ¬ Step A t t'

/-- `=_A`, the equational theory generated by `A` (spec §2.3). -/
def EqA (A : Ax) : Term → Term → Prop := Relation.EqvGen (Step A)

end FricasSymbolic
